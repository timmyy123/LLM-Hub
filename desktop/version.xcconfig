// The LLM Hub desktop version: the only place to change it.
// Read by Xcode (macos/project.yml), MSBuild (Directory.Build.props) and the installer scripts in tools/package.
// MARKETING_VERSION is major.minor.patch. Store uploads need a higher version each time (the Microsoft Store also
// needs the patch number to go up, since MSIX versions are major.minor.patch.0).
// CURRENT_PROJECT_VERSION is the build number (macOS CFBundleVersion, the fourth part of the Windows file version).
MARKETING_VERSION = 0.1.2
CURRENT_PROJECT_VERSION = 3
