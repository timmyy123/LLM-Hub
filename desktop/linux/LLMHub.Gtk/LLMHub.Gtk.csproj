<Project Sdk="Microsoft.NET.Sdk">
  <!-- Native Linux app: GTK4 + libadwaita (via Gir.Core) on top of the shared LLMHub.Core. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LLMHub.Linux</RootNamespace>
    <AssemblyName>llmhub</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GirCore.Adw-1" Version="0.8.1" />
    <PackageReference Include="GirCore.WebKit-6.0" Version="0.8.1" />
    <ProjectReference Include="..\..\core\LLMHub.Core\LLMHub.Core.csproj" />
  </ItemGroup>
</Project>
