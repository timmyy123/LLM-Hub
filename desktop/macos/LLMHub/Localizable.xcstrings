    "ApiAllowLan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow devices on my network"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir dispositivos de mi red"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir dispositivos da minha rede"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser les appareils de mon réseau"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräte in meinem Netzwerk erlauben"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti i dispositivi della mia rete"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить устройства в моей сети"
          }
        }
      }
    },
    "ApiAllowLanHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: only apps on this computer can connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: solo las apps de este equipo pueden conectarse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado: só apps deste computador podem se conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : seules les apps de cet ordinateur peuvent se connecter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus: Nur Apps auf diesem Computer können sich verbinden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato: possono connettersi solo le app di questo computer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено: подключаться могут только приложения на этом компьютере."
          }
        }
      }
    },
