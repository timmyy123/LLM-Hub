    "SettingsEnginesHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LLM Hub picks the fastest build for your hardware and falls back on its own if a GPU backend fails."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LLM Hub elige la versión más rápida para tu hardware y cambia sola a otra si falla la de GPU."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O LLM Hub escolhe a versão mais rápida para o seu hardware e troca sozinho se a de GPU falhar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LLM Hub choisit la version la plus rapide pour votre matériel et en change tout seul si celle pour GPU échoue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LLM Hub wählt die schnellste Version für deine Hardware und wechselt von selbst, wenn das GPU-Backend ausfällt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "LLM Hub sceglie la versione più veloce per il tuo hardware e passa da sola a un'altra se quella GPU non funziona."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "LLM Hub выбирает самую быструю сборку для вашего железа и сам переключается, если GPU-сборка не работает."
          }
        }
      }
    },
