    "AgentEmptyBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a folder, then ask for a change. The agent reads files, edits code and runs commands, asking before it does anything that changes your project."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta y pide un cambio. El agente lee archivos, edita código y ejecuta comandos, y pregunta antes de cambiar tu proyecto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta e peça uma mudança. O agente lê arquivos, edita código e roda comandos, sempre perguntando antes de mudar seu projeto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier, puis demandez une modification. L’agent lit les fichiers, modifie le code et lance des commandes, en demandant avant de changer votre projet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Ordner und bitte um eine Änderung. Der Agent liest Dateien, bearbeitet Code und führt Befehle aus und fragt, bevor er dein Projekt ändert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella e chiedi una modifica. L’agente legge i file, modifica il codice ed esegue comandi, chiedendo prima di cambiare il progetto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите папку и попросите что-то изменить. Агент читает файлы, правит код и запускает команды, спрашивая перед изменением проекта."
          }
        }
      }
    },
