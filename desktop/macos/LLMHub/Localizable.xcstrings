    "AgentFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code talks to LLM Hub's local server on 127.0.0.1, which runs the model on llama.cpp or LiteRT-LM. Nothing leaves this computer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code habla con el servidor local de LLM Hub en 127.0.0.1, que ejecuta el modelo con llama.cpp o LiteRT-LM. Nada sale de este equipo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Claude Code conversa com o servidor local do LLM Hub em 127.0.0.1, que roda o modelo no llama.cpp ou no LiteRT-LM. Nada sai deste computador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code dialogue avec le serveur local de LLM Hub sur 127.0.0.1, qui exécute le modèle avec llama.cpp ou LiteRT-LM. Rien ne quitte cet ordinateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code spricht mit dem lokalen Server von LLM Hub auf 127.0.0.1, der das Modell mit llama.cpp oder LiteRT-LM ausführt. Nichts verlässt diesen Computer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code parla con il server locale di LLM Hub su 127.0.0.1, che esegue il modello con llama.cpp o LiteRT-LM. Nulla lascia questo computer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code обращается к локальному серверу LLM Hub на 127.0.0.1, который запускает модель через llama.cpp или LiteRT-LM. Ничего не покидает этот компьютер."
          }
        }
      }
    },
