    "DesignEmptyBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe a page, an app screen, a slide deck or an animation. The model writes it as HTML you can preview, refine by clicking elements, and export."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe una página, una pantalla de app, una presentación o una animación. El modelo la escribe en HTML para previsualizar, ajustar haciendo clic y exportar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva uma página, uma tela de app, uma apresentação ou uma animação. O modelo escreve em HTML para você ver, ajustar clicando nos elementos e exportar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez une page, un écran d’app, une présentation ou une animation. Le modèle l’écrit en HTML à prévisualiser, affiner en cliquant et exporter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe eine Seite, einen App-Screen, eine Präsentation oder eine Animation. Das Modell schreibt sie als HTML zum Ansehen, Verfeinern per Klick und Exportieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi una pagina, una schermata di app, una presentazione o un’animazione. Il modello la scrive in HTML da vedere, rifinire con un clic ed esportare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишите страницу, экран приложения, презентацию или анимацию. Модель напишет HTML, который можно посмотреть, доработать кликом и экспортировать."
          }
        }
      }
    },
