    "HfHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a quantization. LLM Hub reads the file list straight from the repository and checks every download."
          }
        },
        "es": {
