    "AgentDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run Claude Code against your local models to edit files, run commands and build projects."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Claude Code con tus modelos locales para editar archivos, ejecutar comandos y crear proyectos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o Claude Code com seus modelos locais para editar arquivos, rodar comandos e criar projetos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Claude Code avec vos modèles locaux pour modifier des fichiers, lancer des commandes et créer des projets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze Claude Code mit deinen lokalen Modellen, um Dateien zu bearbeiten, Befehle auszuführen und Projekte zu bauen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Claude Code con i tuoi modelli locali per modificare file, eseguire comandi e creare progetti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускайте Claude Code на локальных моделях: правка файлов, команды, сборка проектов."
          }
        }
      }
    },
