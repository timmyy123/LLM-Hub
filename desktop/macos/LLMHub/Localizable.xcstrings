    "SettingsWebSearchHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, new chats start with web search turned on. Searches go to DuckDuckGo, and only the query leaves this computer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, los chats nuevos empiezan con la búsqueda web activada. Las búsquedas van a DuckDuckGo y solo sale la consulta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, novas conversas começam com a pesquisa na web ligada. As buscas vão para o DuckDuckGo e só a consulta sai do computador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, les nouvelles conversations démarrent avec la recherche web. Les recherches passent par DuckDuckGo et seule la requête quitte cet ordinateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiv, starten neue Chats mit eingeschalteter Websuche. Suchen gehen an DuckDuckGo, nur die Suchanfrage verlässt diesen Computer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attiva, le nuove chat partono con la ricerca web accesa. Le ricerche vanno a DuckDuckGo e solo la richiesta lascia questo computer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включено, новые чаты начинаются с включённым поиском. Запросы уходят в DuckDuckGo, и с компьютера уходит только сам запрос."
          }
        }
      }
    },
