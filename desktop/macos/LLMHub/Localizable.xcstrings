    "DesignHandOffPrompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the design in index.html into a small, well-structured website project. Keep the look, split CSS into its own file, and tell me how to run it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte el diseño de index.html en un pequeño proyecto web bien organizado. Mantén el aspecto, separa el CSS en su propio archivo y dime cómo ejecutarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme o design do index.html em um pequeno projeto web bem organizado. Mantenha o visual, separe o CSS em um arquivo próprio e diga como rodar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme le design d’index.html en un petit projet web bien structuré. Garde l’apparence, sépare le CSS dans son propre fichier et explique comment le lancer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach aus dem Design in index.html ein kleines, sauber aufgebautes Webprojekt. Behalte das Aussehen, lagere das CSS in eine eigene Datei aus und erkläre, wie man es startet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma il design di index.html in un piccolo progetto web ben strutturato. Mantieni l’aspetto, sposta il CSS in un file a parte e spiegami come avviarlo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Преврати дизайн из index.html в небольшой аккуратный веб-проект. Сохрани внешний вид, вынеси CSS в отдельный файл и объясни, как его запустить."
          }
        }
      }
    },
