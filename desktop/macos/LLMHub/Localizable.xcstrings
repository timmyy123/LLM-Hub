    "AgentInstallHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Agent uses Claude Code as its engine, pointed at your local model. Install runs Anthropic's official installer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente usa Claude Code como motor, conectado a tu modelo local. Instalar ejecuta el instalador oficial de Anthropic."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agente usa o Claude Code como motor, ligado ao seu modelo local. Instalar roda o instalador oficial da Anthropic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agent utilise Claude Code comme moteur, relié à votre modèle local. L’installation lance l’installateur officiel d’Anthropic."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent nutzt Claude Code als Engine, verbunden mit deinem lokalen Modell. Installieren startet Anthropics offiziellen Installer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agente usa Claude Code come motore, collegato al tuo modello locale. Installa avvia l’installer ufficiale di Anthropic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент использует Claude Code как движок с вашей локальной моделью. Установка запускает официальный установщик Anthropic."
          }
        }
      }
    },
