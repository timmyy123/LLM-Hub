    "StudioMusicUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live music with Magenta RealTime runs on Apple Silicon Macs. Google has not released a real-time version for Windows or Linux yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La música en vivo con Magenta RealTime funciona en Mac con Apple Silicon. Google aún no ha publicado una versión en tiempo real para Windows ni Linux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A música ao vivo com o Magenta RealTime roda em Macs com Apple Silicon. O Google ainda não lançou uma versão em tempo real para Windows ou Linux."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La musique en direct avec Magenta RealTime fonctionne sur les Mac Apple Silicon. Google n’a pas encore publié de version temps réel pour Windows ou Linux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Musik mit Magenta RealTime läuft auf Macs mit Apple Silicon. Google hat noch keine Echtzeitversion für Windows oder Linux veröffentlicht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La musica dal vivo con Magenta RealTime funziona sui Mac con Apple Silicon. Google non ha ancora rilasciato una versione in tempo reale per Windows o Linux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Живая музыка Magenta RealTime работает на Mac с Apple Silicon. Google пока не выпустил версию реального времени для Windows и Linux."
          }
        }
      }
    },
