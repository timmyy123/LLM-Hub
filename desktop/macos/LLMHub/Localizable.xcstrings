    "MusicSlow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac makes music a little slower than real time, so playback may pause briefly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac genera la música algo más lento que en tiempo real, así que puede haber pausas breves."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac gera a música um pouco mais devagar que o tempo real, então podem ocorrer pausas curtas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac crée la musique un peu moins vite que le temps réel : la lecture peut marquer de courtes pauses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac erzeugt Musik etwas langsamer als in Echtzeit, daher kann die Wiedergabe kurz stocken."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac genera la musica un po' più lentamente del tempo reale, quindi la riproduzione può fermarsi per un attimo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac создаёт музыку чуть медленнее реального времени, поэтому возможны короткие паузы."
          }
        }
      }
    },
