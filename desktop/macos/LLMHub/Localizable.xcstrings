          "stringUnit": {
            "state": "translated",
            "value": "This version only runs on a GPU, and LiteRT-LM could not use the GPU on this computer. Download the standard LiteRT version instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión solo funciona en la GPU, y LiteRT-LM no pudo usar la GPU de este equipo. Descarga la versión LiteRT estándar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão só roda na GPU, e o LiteRT-LM não conseguiu usar a GPU deste computador. Baixe a versão LiteRT padrão."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
