          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une quantification. LLM Hub lit la liste des fichiers directement dans le dépôt et vérifie chaque téléchargement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Quantisierung. LLM Hub liest die Dateiliste direkt aus dem Repository und prüft jeden Download."
