    "SettingsAgentContextHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code's instructions take about 18K tokens, so 64K leaves room for your project."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las instrucciones de Claude Code ocupan unos 18K tokens, así que 64K deja espacio para tu proyecto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As instruções do Claude Code ocupam cerca de 18K tokens, então 64K deixa espaço para o seu projeto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les instructions de Claude Code prennent environ 18K tokens, donc 64K laisse de la place pour votre projet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anweisungen von Claude Code belegen rund 18K Tokens, mit 64K bleibt Platz für dein Projekt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le istruzioni di Claude Code occupano circa 18K token, quindi 64K lascia spazio al tuo progetto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструкции Claude Code занимают около 18K токенов, поэтому 64K оставляет место для проекта."
          }
        }
      }
    },
    "SettingsAgentHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Agent runs Claude Code against LLM Hub's local server, so your code and prompts stay on this computer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Agente usa Claude Code con el servidor local de LLM Hub, así que tu código y tus instrucciones no salen de este equipo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Agente usa o Claude Code com o servidor local do LLM Hub, então seu código e seus pedidos ficam neste computador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Agent fait tourner Claude Code sur le serveur local de LLM Hub : votre code et vos demandes restent sur cet ordinateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent führt Claude Code mit dem lokalen Server von LLM Hub aus, dein Code und deine Anfragen bleiben also auf diesem Computer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Agente usa Claude Code con il server locale di LLM Hub, quindi codice e richieste restano su questo computer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент запускает Claude Code через локальный сервер LLM Hub, поэтому код и запросы остаются на этом компьютере."
          }
        }
      }
    },
    "SettingsAgentNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic doesn't support using Claude Code with models other than Claude. LLM Hub sets this up for you, and the answers come from your local model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic no da soporte al uso de Claude Code con modelos que no sean Claude. LLM Hub lo configura por ti y las respuestas vienen de tu modelo local."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Anthropic não oferece suporte ao uso do Claude Code com modelos que não sejam o Claude. O LLM Hub configura tudo para você, e as respostas vêm do seu modelo local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic ne prend pas en charge l'utilisation de Claude Code avec d'autres modèles que Claude. LLM Hub s'occupe de la configuration, et les réponses viennent de votre modèle local."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic unterstützt die Nutzung von Claude Code mit anderen Modellen als Claude nicht. LLM Hub richtet das für dich ein, die Antworten kommen von deinem lokalen Modell."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic non supporta l'uso di Claude Code con modelli diversi da Claude. LLM Hub lo configura per te e le risposte arrivano dal tuo modello locale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic не поддерживает использование Claude Code с моделями, кроме Claude. LLM Hub всё настроит сам, а отвечать будет ваша локальная модель."
          }
        }
      }
    },
