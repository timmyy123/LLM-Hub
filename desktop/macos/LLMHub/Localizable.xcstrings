    "ApiIntro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let other apps and scripts use your local models through OpenAI or Anthropic style requests."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que otras apps y scripts usen tus modelos locales con peticiones al estilo de OpenAI o Anthropic."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe outros apps e scripts usarem seus modelos locais com requisições no estilo OpenAI ou Anthropic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permettez à d’autres apps et scripts d’utiliser vos modèles locaux avec des requêtes au format OpenAI ou Anthropic."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Apps und Skripte können deine lokalen Modelle über Anfragen im OpenAI- oder Anthropic-Format nutzen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Permetti ad altre app e script di usare i tuoi modelli locali con richieste in stile OpenAI o Anthropic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другие приложения и скрипты смогут работать с вашими локальными моделями через запросы в формате OpenAI или Anthropic."
          }
        }
      }
    },
