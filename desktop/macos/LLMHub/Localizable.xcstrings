    "LiteRtNeedsGpu": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version only runs on a GPU, and LiteRT-LM could not use the GPU on this computer. Download the standard LiteRT version instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión solo funciona en la GPU, y LiteRT-LM no pudo usar la GPU de este equipo. Descarga la versión LiteRT estándar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão só roda na GPU, e o LiteRT-LM não conseguiu usar a GPU deste computador. Baixe a versão LiteRT padrão."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version ne fonctionne que sur GPU, et LiteRT-LM n’a pas pu utiliser le GPU de cet ordinateur. Téléchargez plutôt la version LiteRT standard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version läuft nur auf der GPU, und LiteRT-LM konnte die GPU dieses Computers nicht nutzen. Lade stattdessen die normale LiteRT-Version herunter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione funziona solo sulla GPU e LiteRT-LM non è riuscito a usare la GPU di questo computer. Scarica invece la versione LiteRT standard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта версия работает только на GPU, а LiteRT-LM не смог использовать GPU этого компьютера. Скачайте обычную версию LiteRT."
          }
        }
      }
    },
