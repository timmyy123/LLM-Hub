    "MtpHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multi-token prediction: faster replies on the GPU. Turning it off or on reloads the model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Predicción de varios tokens: respuestas más rápidas en la GPU. Activarla o desactivarla recarga el modelo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsão de vários tokens: respostas mais rápidas na GPU. Ligar ou desligar recarrega o modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prédiction multi-jetons : réponses plus rapides sur le GPU. L’activer ou la désactiver recharge le modèle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Multi-Token-Vorhersage: schnellere Antworten auf der GPU. Ein- oder Ausschalten lädt das Modell neu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsione multi-token: risposte più rapide sulla GPU. Attivarla o disattivarla ricarica il modello."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предсказание нескольких токенов: более быстрые ответы на GPU. При переключении модель перезагружается."
          }
        }
      }
    },
