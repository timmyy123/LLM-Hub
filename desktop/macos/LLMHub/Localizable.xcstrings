    "ComfyUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image and video generation needs an NVIDIA, AMD or Intel GPU, or a Mac. Windows on Arm is not supported yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La generación de imágenes y vídeo necesita una GPU NVIDIA, AMD o Intel, o un Mac. Windows en Arm aún no es compatible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A geração de imagens e vídeos precisa de uma GPU NVIDIA, AMD ou Intel, ou de um Mac. Windows em Arm ainda não é compatível."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La génération d’images et de vidéos nécessite un GPU NVIDIA, AMD ou Intel, ou un Mac. Windows sur Arm n’est pas encore pris en charge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild- und Videoerzeugung braucht eine NVIDIA-, AMD- oder Intel-GPU oder einen Mac. Windows on Arm wird noch nicht unterstützt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La generazione di immagini e video richiede una GPU NVIDIA, AMD o Intel, oppure un Mac. Windows su Arm non è ancora supportato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для изображений и видео нужен GPU NVIDIA, AMD или Intel либо Mac. Windows на Arm пока не поддерживается."
          }
        }
      }
    },
