<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft Store package (MSIX), used only when building with -p:WindowsPackageType=MSIX
     (desktop/tools/package/windows/package-windows.ps1). The version comes from desktop/version.xcconfig, and the
     script replaces the Identity Name, Publisher and PublisherDisplayName with the values Partner Center assigns
     (Product management > Product identity); the ones below are placeholders. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="LLMHub.Desktop" Publisher="CN=LLM Hub" Version="0.0.0.0" />

  <Properties>
    <DisplayName>LLM Hub</DisplayName>
    <PublisherDisplayName>LLM Hub</PublisherDisplayName>
    <Logo>Assets\Package\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="es-ES" />
    <Resource Language="pt-BR" />
    <Resource Language="fr-FR" />
    <Resource Language="de-DE" />
    <Resource Language="it-IT" />
    <Resource Language="ru-RU" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="LLM Hub"
        Description="Run AI models on this PC: chat, agents, design and studio."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Package\Square150x150Logo.png"
        Square44x44Logo="Assets\Package\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Package\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\Package\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A full-trust desktop app: it runs llama.cpp and other engines as child processes. -->
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
    <!-- Settings > Local API serves models on this PC, or on the local network when allowed. -->
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <!-- Dictation (Whisper, on this PC). -->
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
