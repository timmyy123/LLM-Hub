<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LLMHub.Views.StudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LLMHub"
    xmlns:services="using:LLMHub.Services"
    xmlns:studio="using:LLMHub.Services.Studio"
    xmlns:vm="using:LLMHub.ViewModels"
    Background="{ThemeResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Mode tabs and engine status -->
        <Grid Padding="20,0" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="ModeTabs" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <StackPanel.Resources>
                    <!-- Selected tab: the design's filled #2A2A27 pill rather than the accent fill. -->
                    <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="NavSelectedBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="NavSelectedBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="NavSelectedBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextPrimaryBrush" />
                </StackPanel.Resources>
                <ToggleButton x:Name="TabImage" Tag="image" Content="{x:Bind services:Loc.S('StudioImage')}" Click="OnModeClick" Style="{StaticResource StudioTabStyle}" />
                <ToggleButton x:Name="TabVideo" Tag="video" Content="{x:Bind services:Loc.S('StudioVideo')}" Click="OnModeClick" Style="{StaticResource StudioTabStyle}" />
                <ToggleButton x:Name="TabMusic" Tag="music" Content="{x:Bind services:Loc.S('StudioMusic')}" Click="OnModeClick" Style="{StaticResource StudioTabStyle}" />
                <ToggleButton x:Name="TabVoice" Tag="voice" Content="{x:Bind services:Loc.S('StudioVoice')}" Click="OnModeClick" Style="{StaticResource StudioTabStyle}" />
                <ToggleButton x:Name="TabSearch" Tag="search" Content="{x:Bind services:Loc.S('StudioSearch')}" Click="OnModeClick" Style="{StaticResource StudioTabStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="{x:Bind local:Ui.Show(ViewModel.IsImageOrVideo), Mode=OneWay}">
                <Ellipse Width="8" Height="8" Fill="{x:Bind local:Ui.RunningBrush(ViewModel.EngineRunning), Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.EngineStatusLine, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" AutomationProperties.AutomationId="ComfyStatus" />
            </StackPanel>
        </Grid>

        <!-- Image and video -->
        <Grid Grid.Row="1" Visibility="{x:Bind local:Ui.Show(ViewModel.IsImageOrVideo), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,1,0" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind services:Loc.S('StudioWorkflow')}" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="WorkflowPicker" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Workflows}" SelectedItem="{x:Bind ViewModel.Workflow, Mode=TwoWay}" />
                        <TextBlock Text="{x:Bind ViewModel.DownloadNote, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFaintBrush}"
                                   Visibility="{x:Bind local:Ui.ShowText(ViewModel.DownloadNote), Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind services:Loc.S('StudioPrompt')}" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="PromptBox" Text="{x:Bind ViewModel.Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" />
                        <Button x:Name="ImproveButton" Style="{StaticResource OutlineButtonStyle}" Height="30" FontSize="12" Content="{x:Bind services:Loc.S('StudioImprove')}"
                                Command="{x:Bind ViewModel.ImprovePromptCommand}" />
                    </StackPanel>
                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind services:Loc.S('StudioAspect')}" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="AspectPicker" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Aspects, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Aspect, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="{x:Bind services:Loc.S('StudioImages')}" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="CountPicker" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Counts}" SelectionChanged="OnCountChanged" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="6">
                            <TextBlock Text="{x:Bind services:Loc.S('StudioSteps')}" Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox x:Name="StepsBox" Minimum="1" Maximum="100" SpinButtonPlacementMode="Hidden" ValueChanged="OnStepsChanged" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                            <TextBlock Text="{x:Bind services:Loc.S('StudioSeed')}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="SeedBox" Text="{x:Bind ViewModel.Seed, Mode=TwoWay}" PlaceholderText="{x:Bind services:Loc.S('StudioRandom')}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="6" Visibility="{x:Bind local:Ui.Show(ViewModel.NeedsReference), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ReferenceButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="40" CornerRadius="9" Click="OnPickReference"
                                Background="Transparent" BorderBrush="{ThemeResource ControlBorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="{x:Bind local:Ui.ReferenceLabel(ViewModel.ReferenceImage, ViewModel.IsNpu), Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxWidth="230" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource SubtleIconButtonStyle}" Command="{x:Bind ViewModel.ClearReferenceCommand}"
                                Visibility="{x:Bind local:Ui.ShowText(ViewModel.ReferenceImage), Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind services:Loc.S('NpuClearReference')}" AutomationProperties.Name="{x:Bind services:Loc.S('NpuClearReference')}">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap"
                               Visibility="{x:Bind local:Ui.ShowText(ViewModel.Status), Mode=OneWay}" AutomationProperties.AutomationId="StudioStatus" />
                    <TextBlock Text="{x:Bind ViewModel.EngineStatus, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap"
                               Visibility="{x:Bind local:Ui.ShowText(ViewModel.EngineStatus), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.UnsupportedNote, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource WarningBrush}" TextWrapping="Wrap"
                               Visibility="{x:Bind local:Ui.ShowText(ViewModel.UnsupportedNote), Mode=OneWay}" AutomationProperties.AutomationId="StudioUnsupported" />
                    <Button x:Name="GenerateButton" HorizontalAlignment="Stretch" Height="44" CornerRadius="10" FontWeight="SemiBold" Content="{x:Bind services:Loc.S('StudioGenerate')}"
                            Background="{ThemeResource AccentFillBrush}" Foreground="{ThemeResource OnAccentBrush}" BorderThickness="0" Command="{x:Bind ViewModel.GenerateCommand}"
                            Visibility="{x:Bind local:Ui.Hide(ViewModel.IsGenerating), Mode=OneWay}" IsEnabled="{x:Bind ViewModel.ModeSupported, Mode=OneWay}" />
                    <Button x:Name="CancelGenerateButton" HorizontalAlignment="Stretch" Height="44" CornerRadius="10" Content="{x:Bind services:Loc.S('Cancel')}"
                            Command="{x:Bind ViewModel.CancelCommand}" Visibility="{x:Bind local:Ui.Show(ViewModel.IsGenerating), Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" Padding="20" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind services:Loc.S('StudioGallery')}" FontSize="15" FontWeight="Medium" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind local:Ui.SavedTo()}" FontSize="12" Foreground="{ThemeResource TextFaintBrush}" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="2" Width="160" Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Maximum="1" VerticalAlignment="Center"
                                 Visibility="{x:Bind local:Ui.Show(ViewModel.IsGenerating), Mode=OneWay}" />
                </Grid>
                <GridView x:Name="GalleryGrid" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Gallery}" SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                          SelectionMode="Single" IsItemClickEnabled="False">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:GalleryItem">
                            <Border Width="240" Height="160" CornerRadius="12" Background="{ThemeResource SurfaceAltBrush}" AutomationProperties.AutomationId="GalleryItem"
                                    AutomationProperties.Name="{x:Bind Name}">
                                <Grid>
                                    <Image Source="{x:Bind local:Ui.Thumbnail(Path)}" Stretch="UniformToFill" />
                                    <Border Width="36" Height="36" CornerRadius="18" Background="#99000000" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{x:Bind local:Ui.Show(IsVideo)}">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="White" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource OutlineButtonStyle}" Height="34" Content="{x:Bind services:Loc.S('StudioOpen')}" Click="OnOpenItem" />
                    <Button Style="{StaticResource OutlineButtonStyle}" Height="34" Content="{x:Bind services:Loc.S('StudioUseInChat')}" Click="OnUseInChat" />
                    <Button Style="{StaticResource OutlineButtonStyle}" Height="34" Content="{x:Bind services:Loc.S('StudioAnimate')}" Click="OnAnimate"
                            Visibility="{x:Bind local:Ui.Show(ViewModel.CanAnimate)}" />
                    <Button Style="{StaticResource OutlineButtonStyle}" Height="34" Content="{x:Bind services:Loc.S('StudioUpscale')}" Click="OnUpscale"
                            Visibility="{x:Bind local:Ui.Hide(ViewModel.UsesNpuEngine)}" />
                    <Button Style="{StaticResource OutlineButtonStyle}" Height="34" Content="{x:Bind services:Loc.S('NpuImageToImage')}" Click="OnImageToImage"
                            Visibility="{x:Bind local:Ui.Show(ViewModel.UsesNpuEngine)}" />
                    <Button x:Name="OpenComfyButton" Style="{StaticResource OutlineButtonStyle}" Height="34" Click="OnOpenComfy"
                            Visibility="{x:Bind local:Ui.Hide(ViewModel.UsesNpuEngine)}"
                            ToolTipService.ToolTip="{x:Bind services:Loc.S('StudioOpenComfy')}" AutomationProperties.Name="{x:Bind services:Loc.S('StudioOpenComfy')}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                            <TextBlock x:Name="OpenComfyLabel" Text="{x:Bind services:Loc.S('StudioOpenComfy')}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Search: photos and audio by description or by example, with EmbeddingGemma 2 on this computer -->
        <Grid Grid.Row="1" Visibility="{x:Bind local:Ui.Show(ViewModel.IsSearch), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,1,0" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ToggleButton x:Name="SearchPhotosTab" Tag="photos" Content="{x:Bind services:Loc.S('SearchPhotos')}" Click="OnSearchModeClick" CornerRadius="14" IsChecked="True" />
                        <ToggleButton x:Name="SearchAudioTab" Tag="audio" Content="{x:Bind services:Loc.S('SearchAudio')}" Click="OnSearchModeClick" CornerRadius="14" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind services:Loc.S('SearchGetModel')}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                               Visibility="{x:Bind local:Ui.Hide(Search.HasModel), Mode=OneWay}" AutomationProperties.AutomationId="SearchGetModel" />
                    <StackPanel Spacing="6" Visibility="{x:Bind local:Ui.Show(Search.HasModel), Mode=OneWay}">
                        <TextBlock Text="{x:Bind services:Loc.S('SearchModel')}" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="SearchModelPicker" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Search.Models}" SelectedItem="{x:Bind Search.SelectedModel, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind services:Loc.S('SearchFolder')}" Style="{StaticResource FieldLabelStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Search.Folder, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       ToolTipService.ToolTip="{x:Bind Search.Folder, Mode=OneWay}" AutomationProperties.AutomationId="SearchFolder" />
                            <Button Grid.Column="1" Content="{x:Bind services:Loc.S('SearchChange')}" Click="OnSearchFolder" CornerRadius="8" />
                        </Grid>
                    </StackPanel>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SearchIndexButton" HorizontalAlignment="Stretch" CornerRadius="9" Content="{x:Bind services:Loc.S('SearchIndex')}" Command="{x:Bind Search.IndexCommand}"
                                IsEnabled="{x:Bind local:Ui.Not(Search.IsIndexing), Mode=OneWay}" />
                        <Button Grid.Column="1" CornerRadius="9" Content="{x:Bind services:Loc.S('Stop')}" Command="{x:Bind Search.StopIndexingCommand}"
                                Visibility="{x:Bind local:Ui.Show(Search.IsIndexing), Mode=OneWay}" />
                    </Grid>
                    <ProgressBar Value="{x:Bind Search.Progress, Mode=OneWay}" Maximum="1" Visibility="{x:Bind local:Ui.Show(Search.IsIndexing), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Search.IndexedText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" AutomationProperties.AutomationId="SearchIndexed" />
                    <TextBlock Text="{x:Bind Search.Status, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap"
                               Visibility="{x:Bind local:Ui.ShowText(Search.Status), Mode=OneWay}" AutomationProperties.AutomationId="SearchStatus" />
                    <TextBlock Text="{x:Bind services:Loc.S('SearchHelp')}" FontSize="12" Foreground="{ThemeResource TextFaintBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="1" Padding="20" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchQueryBox" Text="{x:Bind Search.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnSearchKeyDown"
                             PlaceholderText="{x:Bind SearchPlaceholder, Mode=OneWay}" />
                    <Button x:Name="SearchButton" Grid.Column="1" Command="{x:Bind Search.SearchCommand}" AutomationProperties.Name="{x:Bind services:Loc.S('StudioSearch')}">
                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                    </Button>
                    <Button x:Name="SearchByPhotoButton" Grid.Column="2" Click="OnSearchByPhoto" Content="{x:Bind services:Loc.S('SearchByPhoto')}" CornerRadius="8"
                            Visibility="{x:Bind local:Ui.Show(Search.IsPhotos), Mode=OneWay}" />
                </Grid>
                <GridView x:Name="SearchPhotoResults" Grid.Row="1" ItemsSource="{x:Bind Search.Photos}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnPhotoMatchClick"
                          Visibility="{x:Bind local:Ui.Show(Search.IsPhotos), Mode=OneWay}">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PhotoMatch">
                            <Grid Width="200" Height="150" CornerRadius="10" ToolTipService.ToolTip="{x:Bind Name}">
                                <Image Source="{x:Bind local:Ui.Thumbnail(Path)}" Stretch="UniformToFill" />
                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="6" Padding="6,2" CornerRadius="6" Background="#99000000">
                                    <TextBlock Text="{x:Bind ScoreText}" FontSize="11" Foreground="White" AutomationProperties.AutomationId="SearchPhotoScore" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <ListView x:Name="SearchAudioResults" Grid.Row="1" ItemsSource="{x:Bind Search.Audio}" SelectionMode="None"
                          Visibility="{x:Bind local:Ui.Show(Search.IsAudio), Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AudioMatch">
                            <Grid ColumnSpacing="12" Padding="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="SearchAudioName" />
                                    <ItemsRepeater ItemsSource="{x:Bind Moments}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="6" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AudioMoment">
                                                <Button Click="OnPlayMoment" Tag="{x:Bind}" CornerRadius="12" Padding="10,3" AutomationProperties.AutomationId="SearchMoment">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE768;" FontSize="10" />
                                                        <TextBlock Text="{x:Bind Label}" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind ScoreText}" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- Voice -->
        <ScrollViewer Grid.Row="1" Padding="28" Visibility="{x:Bind local:Ui.Show(ViewModel.IsVoice), Mode=OneWay}">
            <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="{x:Bind services:Loc.S('StudioVoiceHelp')}" Style="{StaticResource MutedTextStyle}" />
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Bind services:Loc.S('StudioVoiceText')}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="VoiceTextBox" Text="{x:Bind ViewModel.VoiceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ComboBox x:Name="VoicePicker" ItemsSource="{x:Bind ViewModel.Voices}" SelectedItem="{x:Bind ViewModel.Voice, Mode=TwoWay}" MinWidth="120" />
                    <Button x:Name="SpeakButton" Content="{x:Bind services:Loc.S('StudioSpeak')}" Command="{x:Bind ViewModel.SpeakCommand}" CornerRadius="9"
                            Background="{ThemeResource AccentFillBrush}" Foreground="{ThemeResource OnAccentBrush}" BorderThickness="0" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.LastSpeech, Mode=OneWay}" FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource TextFaintBrush}"
                           AutomationProperties.AutomationId="LastSpeechPath" />
            </StackPanel>
        </ScrollViewer>

        <!-- Music: Stable Audio 3 clips through ComfyUI (live Magenta RealTime is on the Mac and on Linux with NVIDIA) -->
        <Grid Grid.Row="1" Visibility="{x:Bind local:Ui.Show(ViewModel.IsMusic), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,1,0" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind services:Loc.S('StudioWorkflow')}" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="MusicModelPicker" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.MusicWorkflows}"
                                  SelectedItem="{x:Bind ViewModel.MusicWorkflow, Mode=TwoWay}" />
                        <TextBlock Text="{x:Bind ViewModel.MusicDownloadNote, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFaintBrush}"
                                   Visibility="{x:Bind local:Ui.ShowText(ViewModel.MusicDownloadNote), Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind services:Loc.S('StudioPrompt')}" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="MusicPromptBox" Text="{x:Bind ViewModel.MusicPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="100" PlaceholderText="{x:Bind services:Loc.S('MusicPromptPlaceholder')}" />
                    </StackPanel>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind services:Loc.S('MusicLength')}" Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox x:Name="MusicSecondsBox" Minimum="1" Maximum="380" SpinButtonPlacementMode="Inline" ValueChanged="OnMusicSecondsChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="{x:Bind services:Loc.S('StudioSeed')}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{x:Bind ViewModel.MusicSeed, Mode=TwoWay}" PlaceholderText="{x:Bind services:Loc.S('StudioRandom')}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.MusicStatus, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap"
                               Visibility="{x:Bind local:Ui.ShowText(ViewModel.MusicStatus), Mode=OneWay}" AutomationProperties.AutomationId="MusicStatus" />
                    <ProgressBar Value="{x:Bind ViewModel.MusicProgress, Mode=OneWay}" Maximum="1" Visibility="{x:Bind local:Ui.Show(ViewModel.IsGeneratingMusic), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind services:Loc.S('ComfyUnsupported')}" FontSize="12" Foreground="{ThemeResource WarningBrush}" TextWrapping="Wrap"
                               Visibility="{x:Bind local:Ui.Hide(ViewModel.ComfySupported)}" />
                    <Button x:Name="GenerateMusicButton" HorizontalAlignment="Stretch" Height="44" CornerRadius="10" FontWeight="SemiBold"
                            Content="{x:Bind services:Loc.S('StudioGenerate')}" Background="{ThemeResource AccentFillBrush}" Foreground="{ThemeResource OnAccentBrush}"
                            BorderThickness="0" Command="{x:Bind ViewModel.GenerateMusicCommand}" IsEnabled="{x:Bind ViewModel.ComfySupported}"
                            Visibility="{x:Bind local:Ui.Hide(ViewModel.IsGeneratingMusic), Mode=OneWay}" />
                    <Button HorizontalAlignment="Stretch" Height="44" CornerRadius="10" Content="{x:Bind services:Loc.S('Cancel')}" Command="{x:Bind ViewModel.CancelMusicCommand}"
                            Visibility="{x:Bind local:Ui.Show(ViewModel.IsGeneratingMusic), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind services:Loc.S('PoweredByStability')}" FontSize="12" Foreground="{ThemeResource TextFaintBrush}"
                               AutomationProperties.AutomationId="PoweredByStability" />
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="1" Padding="20" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{x:Bind services:Loc.S('MusicClips')}" FontSize="15" FontWeight="Medium" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind local:Ui.MusicSavedTo()}" FontSize="12" Foreground="{ThemeResource TextFaintBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <ListView x:Name="MusicClipList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.MusicClips}" SelectionMode="None" ItemContainerStyle="{StaticResource ChatItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:GalleryItem">
                            <Grid ColumnSpacing="10" Padding="0,4" AutomationProperties.AutomationId="MusicClip" AutomationProperties.Name="{x:Bind Name}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource IconButtonStyle}" Tag="{x:Bind Path}" Click="OnPlayClip"
                                        ToolTipService.ToolTip="{x:Bind services:Loc.S('MusicPlay')}" AutomationProperties.Name="{x:Bind services:Loc.S('MusicPlay')}">
                                    <FontIcon Glyph="&#xE768;" FontSize="13" />
                                </Button>
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Tag="{x:Bind Path}" Click="OnShowClip"
                                        ToolTipService.ToolTip="{x:Bind services:Loc.S('SettingsOpenFolder')}" AutomationProperties.Name="{x:Bind services:Loc.S('SettingsOpenFolder')}">
                                    <FontIcon Glyph="&#xE838;" FontSize="13" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
