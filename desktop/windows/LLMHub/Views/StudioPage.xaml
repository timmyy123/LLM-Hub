<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LLMHub.Views.StudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LLMHub"
    xmlns:services="using:LLMHub.Services"
    xmlns:studio="using:LLMHub.Services.Studio"
    xmlns:vm="using:LLMHub.ViewModels"
    Background="{ThemeResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Mode tabs and engine status -->
        <Grid Padding="20,0" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="ModeTabs" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <StackPanel.Resources>
                    <!-- Selected tab: the design's filled #2A2A27 pill rather than the accent fill. -->
                    <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="NavSelectedBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="NavSelectedBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="NavSelectedBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextPrimaryBrush" />
                </StackPanel.Resources>
                <ToggleButton x:Name="TabImage" Tag="image" Content="{x:Bind services:Loc.S('StudioImage')}" Click="OnModeClick" Style="{StaticResource StudioTabStyle}" />
                <ToggleButton x:Name="TabVideo" Tag="video" Content="{x:Bind services:Loc.S('StudioVideo')}" Click="OnModeClick" Style="{StaticResource StudioTabStyle}" />
                <ToggleButton x:Name="TabMusic" Tag="music" Content="{x:Bind services:Loc.S('StudioMusic')}" Click="OnModeClick" Style="{StaticResource StudioTabStyle}" />
                <ToggleButton x:Name="TabVoice" Tag="voice" Content="{x:Bind services:Loc.S('StudioVoice')}" Click="OnModeClick" Style="{StaticResource StudioTabStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="{x:Bind local:Ui.Show(ViewModel.IsImageOrVideo), Mode=OneWay}">
                <Ellipse Width="8" Height="8" Fill="{x:Bind local:Ui.RunningBrush(ViewModel.Comfy.IsRunning), Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.Comfy.StatusLine, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" AutomationProperties.AutomationId="ComfyStatus" />
            </StackPanel>
        </Grid>

        <!-- Image and video -->
        <Grid Grid.Row="1" Visibility="{x:Bind local:Ui.Show(ViewModel.IsImageOrVideo), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,1,0" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind services:Loc.S('StudioWorkflow')}" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="WorkflowPicker" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Workflows}" SelectedItem="{x:Bind ViewModel.Workflow, Mode=TwoWay}" />
                        <TextBlock Text="{x:Bind ViewModel.DownloadNote, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFaintBrush}"
                                   Visibility="{x:Bind local:Ui.ShowText(ViewModel.DownloadNote), Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind services:Loc.S('StudioPrompt')}" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="PromptBox" Text="{x:Bind ViewModel.Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" />
                        <Button x:Name="ImproveButton" Style="{StaticResource OutlineButtonStyle}" Height="30" FontSize="12" Content="{x:Bind services:Loc.S('StudioImprove')}"
                                Command="{x:Bind ViewModel.ImprovePromptCommand}" />
                    </StackPanel>
                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind services:Loc.S('StudioAspect')}" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="AspectPicker" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Aspects}" SelectedItem="{x:Bind ViewModel.Aspect, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="{x:Bind services:Loc.S('StudioImages')}" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="CountPicker" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Counts}" SelectionChanged="OnCountChanged" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="6">
                            <TextBlock Text="{x:Bind services:Loc.S('StudioSteps')}" Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox x:Name="StepsBox" Minimum="1" Maximum="100" SpinButtonPlacementMode="Hidden" ValueChanged="OnStepsChanged" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                            <TextBlock Text="{x:Bind services:Loc.S('StudioSeed')}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="SeedBox" Text="{x:Bind ViewModel.Seed, Mode=TwoWay}" PlaceholderText="{x:Bind services:Loc.S('StudioRandom')}" />
                        </StackPanel>
                    </Grid>
                    <Button x:Name="ReferenceButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="40" CornerRadius="9" Click="OnPickReference"
                            Background="Transparent" BorderBrush="{ThemeResource ControlBorderBrush}" BorderThickness="1"
                            Visibility="{x:Bind local:Ui.Show(ViewModel.NeedsReference), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="{x:Bind local:Ui.ReferenceLabel(ViewModel.ReferenceImage), Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxWidth="250" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap"
                               Visibility="{x:Bind local:Ui.ShowText(ViewModel.Status), Mode=OneWay}" AutomationProperties.AutomationId="StudioStatus" />
                    <TextBlock Text="{x:Bind ViewModel.Comfy.Status, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap"
                               Visibility="{x:Bind local:Ui.ShowText(ViewModel.Comfy.Status), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind services:Loc.S('ComfyUnsupported')}" FontSize="12" Foreground="{ThemeResource WarningBrush}" TextWrapping="Wrap"
                               Visibility="{x:Bind local:Ui.Hide(ViewModel.ComfySupported)}" />
                    <Button x:Name="GenerateButton" HorizontalAlignment="Stretch" Height="44" CornerRadius="10" FontWeight="SemiBold" Content="{x:Bind services:Loc.S('StudioGenerate')}"
                            Background="{ThemeResource AccentFillBrush}" Foreground="{ThemeResource OnAccentBrush}" BorderThickness="0" Command="{x:Bind ViewModel.GenerateCommand}"
                            Visibility="{x:Bind local:Ui.Hide(ViewModel.IsGenerating), Mode=OneWay}" IsEnabled="{x:Bind ViewModel.ComfySupported}" />
                    <Button x:Name="CancelGenerateButton" HorizontalAlignment="Stretch" Height="44" CornerRadius="10" Content="{x:Bind services:Loc.S('Cancel')}"
                            Command="{x:Bind ViewModel.CancelCommand}" Visibility="{x:Bind local:Ui.Show(ViewModel.IsGenerating), Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" Padding="20" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind services:Loc.S('StudioGallery')}" FontSize="15" FontWeight="Medium" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind local:Ui.SavedTo()}" FontSize="12" Foreground="{ThemeResource TextFaintBrush}" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="2" Width="160" Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Maximum="1" VerticalAlignment="Center"
                                 Visibility="{x:Bind local:Ui.Show(ViewModel.IsGenerating), Mode=OneWay}" />
                </Grid>
                <GridView x:Name="GalleryGrid" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Gallery}" SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                          SelectionMode="Single" IsItemClickEnabled="False">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:GalleryItem">
                            <Border Width="240" Height="160" CornerRadius="12" Background="{ThemeResource SurfaceAltBrush}" AutomationProperties.AutomationId="GalleryItem"
                                    AutomationProperties.Name="{x:Bind Name}">
                                <Image Source="{x:Bind local:Ui.Thumbnail(Path)}" Stretch="UniformToFill" />
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource OutlineButtonStyle}" Height="34" Content="{x:Bind services:Loc.S('StudioUseInChat')}" Click="OnUseInChat" />
                    <Button Style="{StaticResource OutlineButtonStyle}" Height="34" Content="{x:Bind services:Loc.S('StudioAnimate')}" Click="OnAnimate" />
                    <Button Style="{StaticResource OutlineButtonStyle}" Height="34" Content="{x:Bind services:Loc.S('StudioUpscale')}" Click="OnUpscale" />
                    <Button Style="{StaticResource OutlineButtonStyle}" Height="34" Content="{x:Bind services:Loc.S('StudioOpenComfy')}" Click="OnOpenComfy" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Voice -->
        <ScrollViewer Grid.Row="1" Padding="28" Visibility="{x:Bind local:Ui.Show(ViewModel.IsVoice), Mode=OneWay}">
            <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="{x:Bind services:Loc.S('StudioVoiceHelp')}" Style="{StaticResource MutedTextStyle}" />
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Bind services:Loc.S('StudioVoiceText')}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="VoiceTextBox" Text="{x:Bind ViewModel.VoiceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ComboBox x:Name="VoicePicker" ItemsSource="{x:Bind ViewModel.Voices}" SelectedItem="{x:Bind ViewModel.Voice, Mode=TwoWay}" MinWidth="120" />
                    <Button x:Name="SpeakButton" Content="{x:Bind services:Loc.S('StudioSpeak')}" Command="{x:Bind ViewModel.SpeakCommand}" CornerRadius="9"
                            Background="{ThemeResource AccentFillBrush}" Foreground="{ThemeResource OnAccentBrush}" BorderThickness="0" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.LastSpeech, Mode=OneWay}" FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource TextFaintBrush}"
                           AutomationProperties.AutomationId="LastSpeechPath" />
            </StackPanel>
        </ScrollViewer>

        <!-- Music (Magenta RealTime runs on Apple Silicon only) -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Spacing="12"
                    Visibility="{x:Bind local:Ui.Show(ViewModel.IsMusic), Mode=OneWay}">
            <FontIcon Glyph="&#xE8D6;" FontSize="32" Foreground="{ThemeResource TextMutedBrush}" />
            <TextBlock Text="{x:Bind services:Loc.S('StudioMusicUnavailable')}" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}"
                       AutomationProperties.AutomationId="MusicUnavailable" />
        </StackPanel>
    </Grid>
</Page>
