<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LLMHub.Views.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBackgroundBrush}">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" MaxWidth="520">
        <FontIcon x:Name="Icon" FontSize="32" Foreground="{ThemeResource TextMutedBrush}" />
        <TextBlock x:Name="Heading" AutomationProperties.AutomationId="PlaceholderHeading" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
        <TextBlock x:Name="Body" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
    </StackPanel>
</Page>
