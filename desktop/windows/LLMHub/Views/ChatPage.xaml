<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LLMHub.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LLMHub"
    xmlns:services="using:LLMHub.Services"
    xmlns:vm="using:LLMHub.ViewModels"
    Background="{ThemeResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1" Padding="24,0">
            <TextBlock x:Name="ChatHeaderTitle" Text="{x:Bind ViewModel.CurrentTitle, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Empty state -->
        <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="520"
                    Visibility="{x:Bind local:Ui.Hide(ViewModel.HasMessages), Mode=OneWay}">
            <TextBlock Text="{x:Bind services:Loc.S('EmptyChatTitle')}" AutomationProperties.AutomationId="EmptyTitle" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <StackPanel Spacing="12" Visibility="{x:Bind local:Ui.Hide(ViewModel.HasModels), Mode=OneWay}">
                <TextBlock Text="{x:Bind services:Loc.S('EmptyNoModel')}" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                <Button x:Name="GetModelButton" Style="{StaticResource PrimaryPillButtonStyle}" HorizontalAlignment="Center" Click="OnGetModel"
                        Content="{x:Bind services:Loc.S('GetModel')}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" Padding="24,28,24,8" HorizontalScrollMode="Disabled"
                      Visibility="{x:Bind local:Ui.Show(ViewModel.HasMessages), Mode=OneWay}">
            <ItemsRepeater x:Name="MessageList" ItemsSource="{x:Bind ViewModel.Messages}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:MessageItem">
                        <Grid MaxWidth="760" Margin="0,0,0,24">
                            <!-- User -->
                            <Border Visibility="{x:Bind local:Ui.Show(IsUser)}" HorizontalAlignment="Right" MaxWidth="600"
                                    Background="{ThemeResource UserBubbleBrush}" CornerRadius="16" Padding="16,12">
                                <TextBlock Text="{x:Bind Content, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="15" AutomationProperties.AutomationId="UserMessage" />
                            </Border>
                            <!-- Assistant -->
                            <StackPanel Visibility="{x:Bind local:Ui.Hide(IsUser)}" Spacing="10">
                                <Expander Visibility="{x:Bind local:Ui.ShowText(Reasoning), Mode=OneWay}" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch" Header="{x:Bind services:Loc.S('Thinking')}" AutomationProperties.AutomationId="ThinkingExpander">
                                    <TextBlock Text="{x:Bind Reasoning, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               Foreground="{ThemeResource TextMutedBrush}" FontSize="13" />
                                </Expander>
                                <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{x:Bind local:Ui.ShowText(Status), Mode=OneWay}">
                                    <ProgressRing Width="16" Height="16" IsActive="True" />
                                    <TextBlock Text="{x:Bind Status, Mode=OneWay}" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="MessageStatus" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Content, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="15" LineHeight="24" AutomationProperties.AutomationId="AssistantMessage" />
                                <TextBlock Text="{x:Bind Footer, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" AutomationProperties.AutomationId="MessageFooter"
                                           Visibility="{x:Bind local:Ui.ShowText(Footer), Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Composer -->
        <Grid Grid.Row="2" Padding="24,8,24,20">
            <Border MaxWidth="760" CornerRadius="18" BorderThickness="1" BorderBrush="{ThemeResource ControlBorderBrush}"
                    Background="{ThemeResource SurfaceBrush}" Padding="14,10,10,10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="Composer" Text="{x:Bind ViewModel.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{x:Bind services:Loc.S('ComposerPlaceholder')}" AcceptsReturn="True" TextWrapping="Wrap"
                             MaxHeight="220" FontSize="15" BorderThickness="0" Background="Transparent" Padding="4,4"
                             PreviewKeyDown="OnComposerKeyDown" />
                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="MtpToggle" Grid.Column="0" HorizontalAlignment="Right" CornerRadius="10" MinHeight="32"
                                      Content="{x:Bind services:Loc.S('Mtp')}" ToolTipService.ToolTip="{x:Bind services:Loc.S('MtpHelp')}"
                                      IsChecked="{x:Bind ViewModel.MtpEnabled, Mode=TwoWay}"
                                      Visibility="{x:Bind local:Ui.Show(ViewModel.MtpVisible), Mode=OneWay}" />
                        <ComboBox x:Name="ModelPicker" Grid.Column="1" MinWidth="220" ItemsSource="{x:Bind ViewModel.Models}"
                                  SelectedItem="{x:Bind ViewModel.SelectedModel, Mode=TwoWay}"
                                  PlaceholderText="{x:Bind services:Loc.S('ChooseModel')}" BorderThickness="0" Background="Transparent">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="services:InstalledModel">
                                    <TextBlock Text="{x:Bind DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="SendButton" Grid.Column="2" Width="36" Height="36" Padding="0" CornerRadius="10" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.SendCommand}" ToolTipService.ToolTip="{x:Bind services:Loc.S('Send')}"
                                AutomationProperties.Name="{x:Bind services:Loc.S('Send')}"
                                Visibility="{x:Bind local:Ui.Hide(ViewModel.IsGenerating), Mode=OneWay}">
                            <FontIcon Glyph="&#xE74A;" FontSize="14" />
                        </Button>
                        <Button x:Name="StopButton" Grid.Column="2" Width="36" Height="36" Padding="0" CornerRadius="10"
                                Command="{x:Bind ViewModel.StopCommand}" ToolTipService.ToolTip="{x:Bind services:Loc.S('Stop')}"
                                AutomationProperties.Name="{x:Bind services:Loc.S('Stop')}"
                                Visibility="{x:Bind local:Ui.Show(ViewModel.IsGenerating), Mode=OneWay}">
                            <FontIcon Glyph="&#xE71A;" FontSize="12" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
