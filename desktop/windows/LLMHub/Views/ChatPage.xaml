<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LLMHub.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LLMHub"
    xmlns:views="using:LLMHub.Views"
    xmlns:services="using:LLMHub.Services"
    xmlns:vm="using:LLMHub.ViewModels"
    Background="{ThemeResource AppBackgroundBrush}"
    AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">

    <Page.Resources>
        <!-- File chip: coloured badge (PDF, PNG, ...), name and detail. Used in sent messages and in the composer. -->
        <DataTemplate x:Key="AttachmentChip" x:DataType="services:Attachment">
            <Border CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ChipBorderBrush}" Background="{ThemeResource AttachmentChipBrush}"
                    Padding="8,8,12,8" AutomationProperties.AutomationId="AttachmentChip" AutomationProperties.Name="{x:Bind Name}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="32" Height="36" CornerRadius="6" Background="{x:Bind local:Ui.BadgeBrush(IsImage, 'bg')}">
                        <TextBlock Text="{x:Bind Badge}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{x:Bind local:Ui.BadgeBrush(IsImage, 'fg')}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" MaxWidth="200">
                        <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Detail}" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title, star, Share -->
        <Grid BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1" Padding="24,0,16,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ChatHeaderTitle" Text="{x:Bind ViewModel.CurrentTitle, Mode=OneWay}" FontSize="15" FontWeight="Medium" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="560" />
            <Button x:Name="StarButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.ToggleStarCommand}"
                    Visibility="{x:Bind local:Ui.Show(ViewModel.HasOpenChat), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind local:Ui.StarLabel(ViewModel.IsCurrentStarred), Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind local:Ui.StarLabel(ViewModel.IsCurrentStarred), Mode=OneWay}">
                <FontIcon Glyph="{x:Bind local:Ui.StarGlyph(ViewModel.IsCurrentStarred), Mode=OneWay}" FontSize="14" />
            </Button>
            <Button x:Name="ShareButton" Grid.Column="3" Style="{StaticResource OutlineButtonStyle}" Content="{x:Bind services:Loc.S('Share')}" Click="OnShare"
                    Visibility="{x:Bind local:Ui.Show(ViewModel.HasMessages), Mode=OneWay}" />
        </Grid>

        <!-- Empty state -->
        <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="520"
                    Visibility="{x:Bind local:Ui.Hide(ViewModel.HasMessages), Mode=OneWay}">
            <TextBlock Text="{x:Bind services:Loc.S('EmptyChatTitle')}" AutomationProperties.AutomationId="EmptyTitle" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <StackPanel Spacing="12" Visibility="{x:Bind local:Ui.Hide(ViewModel.HasModels), Mode=OneWay}">
                <TextBlock Text="{x:Bind services:Loc.S('EmptyNoModel')}" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                <Button x:Name="GetModelButton" Style="{StaticResource PrimaryPillButtonStyle}" HorizontalAlignment="Center" Click="OnGetModel"
                        Content="{x:Bind services:Loc.S('GetModel')}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" Padding="24,32,24,16" HorizontalScrollMode="Disabled"
                      Visibility="{x:Bind local:Ui.Show(ViewModel.HasMessages), Mode=OneWay}">
            <ItemsRepeater x:Name="MessageList" ItemsSource="{x:Bind ViewModel.Messages}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:MessageItem">
                        <Grid MaxWidth="760" Margin="0,0,0,28">
                            <!-- User: file chips, then the bubble -->
                            <StackPanel Visibility="{x:Bind local:Ui.Show(IsUser)}" HorizontalAlignment="Right" MaxWidth="608" Spacing="8">
                                <ItemsRepeater ItemsSource="{x:Bind Attachments}" ItemTemplate="{StaticResource AttachmentChip}" HorizontalAlignment="Right"
                                               Visibility="{x:Bind local:Ui.Show(HasAttachments), Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="8" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                                <Border HorizontalAlignment="Right" Background="{ThemeResource UserBubbleBrush}" CornerRadius="16" Padding="16,12">
                                    <TextBlock Text="{x:Bind Content, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="15" LineHeight="24"
                                               AutomationProperties.AutomationId="UserMessage" />
                                </Border>
                            </StackPanel>
                            <!-- Assistant -->
                            <StackPanel Visibility="{x:Bind local:Ui.Hide(IsUser)}" Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Style="{StaticResource ActivityPillStyle}" Visibility="{x:Bind local:Ui.ShowText(Activity), Mode=OneWay}"
                                            AutomationProperties.AutomationId="ActivityPill">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE774;" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" />
                                            <TextBlock Text="{x:Bind Activity, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <ToggleButton Height="30" IsChecked="{x:Bind ReasoningOpen, Mode=TwoWay}" Padding="12,0" CornerRadius="15" FontSize="13" Background="Transparent"
                                                  BorderBrush="{ThemeResource ChipBorderBrush}" BorderThickness="1" Foreground="{ThemeResource TextSecondaryBrush}"
                                                  Visibility="{x:Bind local:Ui.ShowText(Reasoning), Mode=OneWay}" AutomationProperties.AutomationId="ThinkingExpander"
                                                  Content="{x:Bind local:Ui.ThinkingLabel(IsDone), Mode=OneWay}" />
                                </StackPanel>
                                <Border Visibility="{x:Bind local:Ui.Show(ReasoningOpen), Mode=OneWay}" BorderBrush="{ThemeResource ControlBorderBrush}"
                                        BorderThickness="2,0,0,0" Padding="14,2,0,2">
                                    <TextBlock Text="{x:Bind Reasoning, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               Foreground="{ThemeResource TextMutedBrush}" FontSize="13" LineHeight="21" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{x:Bind local:Ui.ShowText(Status), Mode=OneWay}">
                                    <ProgressRing Width="16" Height="16" IsActive="True" />
                                    <TextBlock Text="{x:Bind Status, Mode=OneWay}" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="MessageStatus" />
                                </StackPanel>
                                <views:MarkdownView Text="{x:Bind Content, Mode=OneWay}" AutomationProperties.AutomationId="AssistantMessage"
                                                    AutomationProperties.Name="{x:Bind Content, Mode=OneWay}" />
                                <!-- Web sources: numbered, with a host chip that opens the page -->
                                <ItemsRepeater ItemsSource="{x:Bind Sources}" Visibility="{x:Bind local:Ui.Show(HasSources), Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="6" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="services:WebSource">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{x:Bind local:Ui.Numbered(Number)}" Foreground="{ThemeResource TextMutedBrush}" FontSize="13" />
                                                <TextBlock Text="{x:Bind Title}" Foreground="{ThemeResource BodyTextBrush}" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                                                <HyperlinkButton NavigateUri="{x:Bind Link}" Padding="6,1" FontSize="12" CornerRadius="6" Background="{ThemeResource SourceChipBrush}"
                                                                 Content="{x:Bind Host}" AutomationProperties.AutomationId="SourceLink" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <!-- Actions and model -->
                                <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind local:Ui.Show(ShowActions), Mode=OneWay}">
                                    <Button Style="{StaticResource IconButtonStyle}" Click="OnCopyMessage" Tag="{x:Bind}" ToolTipService.ToolTip="{x:Bind services:Loc.S('Copy')}"
                                            AutomationProperties.Name="{x:Bind services:Loc.S('Copy')}" AutomationProperties.AutomationId="CopyMessageButton">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}" Click="OnReadAloud" Tag="{x:Bind}" ToolTipService.ToolTip="{x:Bind services:Loc.S('ReadAloud')}"
                                            AutomationProperties.Name="{x:Bind services:Loc.S('ReadAloud')}" AutomationProperties.AutomationId="ReadAloudButton">
                                        <FontIcon Glyph="&#xE767;" FontSize="14" />
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}" Click="OnRegenerate" Tag="{x:Bind}" ToolTipService.ToolTip="{x:Bind services:Loc.S('Regenerate')}"
                                            AutomationProperties.Name="{x:Bind services:Loc.S('Regenerate')}" AutomationProperties.AutomationId="RegenerateButton">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    </Button>
                                    <TextBlock Text="{x:Bind Footer, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFaintBrush}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" AutomationProperties.AutomationId="MessageFooter" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Composer -->
        <StackPanel Grid.Row="2" Padding="24,8,24,20" Spacing="8">
            <Border MaxWidth="760" CornerRadius="18" BorderThickness="1" BorderBrush="{ThemeResource ControlBorderBrush}"
                    Background="{ThemeResource SurfaceBrush}" Padding="14,14,14,10">
                <StackPanel Spacing="10">
                    <ItemsRepeater x:Name="PendingAttachments" ItemsSource="{x:Bind ViewModel.PendingAttachments}"
                                   Visibility="{x:Bind local:Ui.Show(ViewModel.HasPendingAttachments), Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="services:Attachment">
                                <Grid>
                                    <ContentControl Content="{x:Bind}" ContentTemplate="{StaticResource AttachmentChip}" />
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Width="20" Height="20" Padding="0" CornerRadius="10"
                                            Click="OnRemoveAttachment" Tag="{x:Bind}" AutomationProperties.Name="{x:Bind services:Loc.S('Delete')}"
                                            AutomationProperties.AutomationId="RemoveAttachmentButton">
                                        <FontIcon Glyph="&#xE711;" FontSize="9" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock Text="{x:Bind ViewModel.AttachError, Mode=OneWay}" Foreground="{ThemeResource DangerBrush}" FontSize="12" TextWrapping="Wrap"
                               Visibility="{x:Bind local:Ui.ShowText(ViewModel.AttachError), Mode=OneWay}" AutomationProperties.AutomationId="AttachError" />
                    <TextBox x:Name="Composer" Text="{x:Bind ViewModel.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{x:Bind services:Loc.S('ComposerPlaceholder')}" AcceptsReturn="True" TextWrapping="Wrap"
                             MaxHeight="220" FontSize="15" BorderThickness="0" Background="Transparent" Padding="4,2"
                             PreviewKeyDown="OnComposerKeyDown">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AttachButton" Style="{StaticResource ComposerIconButtonStyle}" Click="OnAttach"
                                ToolTipService.ToolTip="{x:Bind services:Loc.S('Attach')}" AutomationProperties.Name="{x:Bind services:Loc.S('Attach')}">
                            <FontIcon Glyph="&#xE723;" FontSize="15" />
                        </Button>
                        <ToggleButton x:Name="WebSearchToggle" Grid.Column="1" Style="{StaticResource ComposerToggleStyle}"
                                      IsChecked="{x:Bind ViewModel.WebSearchEnabled, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE774;" FontSize="13" />
                                <TextBlock Text="{x:Bind services:Loc.S('WebSearch')}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="ThinkingToggle" Grid.Column="2" Style="{StaticResource ComposerToggleStyle}"
                                      Content="{x:Bind services:Loc.S('ExtendedThinking')}" IsChecked="{x:Bind ViewModel.ThinkingEnabled, Mode=TwoWay}" />
                        <ToggleButton x:Name="MtpToggle" Grid.Column="3" Style="{StaticResource ComposerToggleStyle}"
                                      Content="{x:Bind services:Loc.S('Mtp')}" ToolTipService.ToolTip="{x:Bind services:Loc.S('MtpHelp')}"
                                      IsChecked="{x:Bind ViewModel.MtpEnabled, Mode=TwoWay}"
                                      Visibility="{x:Bind local:Ui.Show(ViewModel.MtpVisible), Mode=OneWay}" />
                        <TextBlock x:Name="ContextMeter" Grid.Column="5" Text="{x:Bind ViewModel.ContextText, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource TextFaintBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox x:Name="ModelPicker" Grid.Column="6" MinWidth="180" ItemsSource="{x:Bind ViewModel.Models}"
                                  SelectedItem="{x:Bind ViewModel.SelectedModel, Mode=TwoWay}" FontSize="13"
                                  PlaceholderText="{x:Bind services:Loc.S('ChooseModel')}" BorderThickness="0" Background="Transparent">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="services:InstalledModel">
                                    <TextBlock Text="{x:Bind DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="DictateButton" Grid.Column="7" Style="{StaticResource ComposerIconButtonStyle}" Click="OnDictate"
                                ToolTipService.ToolTip="{x:Bind services:Loc.S('Dictate')}" AutomationProperties.Name="{x:Bind services:Loc.S('Dictate')}">
                            <FontIcon x:Name="DictateIcon" Glyph="&#xE720;" FontSize="15" />
                        </Button>
                        <Button x:Name="SendButton" Grid.Column="8" Width="36" Height="36" Padding="0" CornerRadius="10"
                                Background="{ThemeResource AccentFillBrush}" Foreground="{ThemeResource OnAccentBrush}" BorderThickness="0"
                                Command="{x:Bind ViewModel.SendCommand}" ToolTipService.ToolTip="{x:Bind services:Loc.S('Send')}"
                                AutomationProperties.Name="{x:Bind services:Loc.S('Send')}"
                                Visibility="{x:Bind local:Ui.Hide(ViewModel.IsGenerating), Mode=OneWay}">
                            <FontIcon Glyph="&#xE74A;" FontSize="14" />
                        </Button>
                        <Button x:Name="StopButton" Grid.Column="8" Width="36" Height="36" Padding="0" CornerRadius="10"
                                Command="{x:Bind ViewModel.StopCommand}" ToolTipService.ToolTip="{x:Bind services:Loc.S('Stop')}"
                                AutomationProperties.Name="{x:Bind services:Loc.S('Stop')}"
                                Visibility="{x:Bind local:Ui.Show(ViewModel.IsGenerating), Mode=OneWay}">
                            <FontIcon Glyph="&#xE71A;" FontSize="12" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Text="{x:Bind services:Loc.S('PrivacyNote')}" FontSize="12" Foreground="{ThemeResource TextFaintBrush}" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="760" />
        </StackPanel>
    </Grid>
</Page>
