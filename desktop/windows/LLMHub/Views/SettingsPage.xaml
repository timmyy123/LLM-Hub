<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LLMHub.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LLMHub"
    xmlns:services="using:LLMHub.Services"
    xmlns:vm="using:LLMHub.ViewModels"
    Background="{ThemeResource AppBackgroundBrush}">

    <Page.Resources>
        <!-- One row: name, variant picker, fit, and download / progress / installed state. Shared by the catalog and Hugging Face tabs. -->
        <DataTemplate x:Key="VariantPickerTemplate" x:DataType="vm:DownloadableViewModel">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <ComboBox HorizontalAlignment="Stretch" AutomationProperties.AutomationId="VariantPicker" ItemsSource="{x:Bind Variants}" SelectedItem="{x:Bind SelectedVariant, Mode=TwoWay}"
                          IsEnabled="{x:Bind local:Ui.Not(IsLoadingVariants), Mode=OneWay}"
                          Visibility="{x:Bind local:Ui.Show(CanPick), Mode=OneWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:VariantOption">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Label}" />
                                <TextBlock Text="{x:Bind FitText}" Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Button HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" CornerRadius="9"
                            Content="{x:Bind services:Loc.S('Download')}" Command="{x:Bind DownloadCommand}" AutomationProperties.AutomationId="DownloadButton"
                            Visibility="{x:Bind local:Ui.Show(CanDownload), Mode=OneWay}" />
                    <Grid ColumnSpacing="8" Visibility="{x:Bind local:Ui.Show(IsDownloading), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <ProgressBar Value="{x:Bind Job.Percent, Mode=OneWay, FallbackValue=0}" Maximum="100" AutomationProperties.AutomationId="DownloadProgress" />
                            <TextBlock Text="{x:Bind Job.Status, Mode=OneWay, FallbackValue=''}" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SubtleIconButtonStyle}" Command="{x:Bind CancelCommand}" AutomationProperties.AutomationId="CancelDownloadButton"
                                ToolTipService.ToolTip="{x:Bind services:Loc.S('Cancel')}" AutomationProperties.Name="{x:Bind services:Loc.S('Cancel')}">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>
                    <Grid ColumnSpacing="8" Visibility="{x:Bind local:Ui.Show(IsInstalled), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SuccessBrush}" />
                            <TextBlock Text="{x:Bind services:Loc.S('Installed')}" AutomationProperties.AutomationId="InstalledLabel" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SubtleIconButtonStyle}" Command="{x:Bind DeleteCommand}" AutomationProperties.AutomationId="DeleteModelButton"
                                ToolTipService.ToolTip="{x:Bind services:Loc.S('Delete')}" AutomationProperties.Name="{x:Bind services:Loc.S('Delete')}">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <!-- General -->
        <ScrollViewer x:Name="GeneralPanel" Padding="28,24" Visibility="Collapsed">
            <StackPanel Spacing="20" MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Text="{x:Bind services:Loc.S('SettingsGeneral')}" FontSize="20" FontWeight="SemiBold" />
                <StackPanel Spacing="6">
                    <ComboBox x:Name="LanguageBox" Header="{x:Bind services:Loc.S('Language')}" MinWidth="260" SelectionChanged="OnLanguageChanged" />
                    <TextBlock x:Name="RestartHint" Text="{x:Bind services:Loc.S('LanguageRestart')}" Style="{StaticResource MutedTextStyle}" Visibility="Collapsed" />
                </StackPanel>
                <ComboBox x:Name="ContextBox" Header="{x:Bind services:Loc.S('ContextLength')}" MinWidth="260" SelectionChanged="OnContextChanged" />
                <StackPanel Spacing="6">
                    <PasswordBox x:Name="TokenBox" Header="{x:Bind services:Loc.S('HfToken')}" MinWidth="360" PasswordChanged="OnTokenChanged" />
                    <TextBlock Text="{x:Bind services:Loc.S('HfTokenHelp')}" Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Models -->
        <Grid x:Name="ModelsPanel" Padding="28,24,28,0" RowSpacing="14" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind services:Loc.S('SettingsModels')}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind Models.HardwareText}" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
            <SelectorBar x:Name="ModelTabs" Grid.Row="1" SelectionChanged="OnModelTabChanged">
                <SelectorBarItem Tag="catalog" AutomationProperties.AutomationId="TabCatalog" Text="{x:Bind services:Loc.S('TabCatalog')}" IsSelected="True" />
                <SelectorBarItem Tag="hf" AutomationProperties.AutomationId="TabHuggingFace" Text="{x:Bind services:Loc.S('TabHuggingFace')}" />
                <SelectorBarItem Tag="installed" AutomationProperties.AutomationId="TabInstalled" Text="{x:Bind services:Loc.S('TabInstalled')}" />
            </SelectorBar>

            <!-- Catalog -->
            <ListView x:Name="CatalogList" Grid.Row="2" SelectionMode="None" ItemsSource="{x:Bind Models.Catalog}" Padding="0,0,0,24">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,10" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CatalogItemViewModel">
                        <Grid ColumnSpacing="14" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="180" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" AutomationProperties.AutomationId="CatalogName" />
                                    <Border Style="{StaticResource TagBorderStyle}">
                                        <TextBlock Text="{x:Bind EngineLabel}" FontSize="11" Foreground="{ThemeResource TagTextBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource MutedTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource MutedTextStyle}"
                                           Visibility="{x:Bind local:Ui.ShowText(Status), Mode=OneWay}" />
                            </StackPanel>
                            <ContentControl Grid.Column="1" Content="{x:Bind}" ContentTemplate="{StaticResource VariantPickerTemplate}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Hugging Face -->
            <Grid x:Name="HfPanel" Grid.Row="2" ColumnSpacing="16" Visibility="Collapsed" Padding="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HfQuery" Text="{x:Bind Models.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="{x:Bind services:Loc.S('SearchHf')}" KeyDown="OnHfSearchKeyDown" />
                        <Button x:Name="HfSearchButton" Grid.Column="1" Command="{x:Bind Models.SearchCommand}" AutomationProperties.Name="{x:Bind services:Loc.S('SearchHf')}">
                            <FontIcon Glyph="&#xE721;" FontSize="14" />
                        </Button>
                    </Grid>
                    <ListView x:Name="HfResults" Grid.Row="1" ItemsSource="{x:Bind Models.SearchResults}" SelectedItem="{x:Bind Models.SelectedRepo, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:HfRepoViewModel">
                                <StackPanel Padding="0,8">
                                    <TextBlock Text="{x:Bind Id}" FontFamily="Cascadia Mono, Consolas" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <Border Grid.Column="1" CornerRadius="14" BorderThickness="1" BorderBrush="{ThemeResource DividerBrush}"
                        Background="{ThemeResource SurfaceAltBrush}" Padding="18" VerticalAlignment="Top"
                        Visibility="{x:Bind local:Ui.Show(Models.HasSelectedRepo), Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind Models.SelectedRepo.Id, Mode=OneWay, FallbackValue=''}" FontFamily="Cascadia Mono, Consolas" FontSize="15" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Models.SelectedRepo.Status, Mode=OneWay, FallbackValue=''}" Style="{StaticResource MutedTextStyle}" AutomationProperties.AutomationId="RepoStatus" />
                        <ContentControl x:Name="HfDetail" Content="{x:Bind Models.SelectedRepo, Mode=OneWay}" ContentTemplate="{StaticResource VariantPickerTemplate}" />
                        <TextBlock Text="{x:Bind services:Loc.S('HfHint')}" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Installed -->
            <Grid x:Name="InstalledPanel" Grid.Row="2" Visibility="Collapsed">
                <TextBlock Text="{x:Bind services:Loc.S('NoInstalled')}" Style="{StaticResource MutedTextStyle}"
                           Visibility="{x:Bind local:Ui.Hide(Models.HasInstalled), Mode=OneWay}" />
                <ListView x:Name="InstalledList" ItemsSource="{x:Bind Models.Installed}" SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="12,10" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:InstalledModel">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" AutomationProperties.AutomationId="InstalledName" />
                                    <TextBlock Text="{x:Bind Repo}" Style="{StaticResource MutedTextStyle}" FontFamily="Cascadia Mono, Consolas" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" />
                                <Button Grid.Column="2" Style="{StaticResource SubtleIconButtonStyle}" Click="OnDeleteInstalled" Tag="{x:Bind}" AutomationProperties.AutomationId="DeleteInstalledButton"
                                        ToolTipService.ToolTip="{x:Bind services:Loc.S('Delete')}" AutomationProperties.Name="{x:Bind services:Loc.S('Delete')}">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- Local API -->
        <ScrollViewer x:Name="ApiPanel" Padding="28,24" Visibility="Collapsed">
            <StackPanel Spacing="18" MaxWidth="860" HorizontalAlignment="Left">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind services:Loc.S('SettingsLocalApi')}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind services:Loc.S('ApiIntro')}" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="ApiToggle" Grid.Column="1" Header="{x:Bind services:Loc.S('ApiServing')}" Toggled="OnApiToggled" />
                </Grid>
                <TextBlock Text="{x:Bind Api.Error, Mode=OneWay}" Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap"
                           Visibility="{x:Bind local:Ui.ShowText(Api.Error), Mode=OneWay}" AutomationProperties.AutomationId="ApiError" />

                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind services:Loc.S('ApiBaseUrl')}" Style="{StaticResource SectionLabelStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="BaseUrlBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" />
                                <Button Grid.Column="1" Click="OnCopyBaseUrl" AutomationProperties.Name="{x:Bind services:Loc.S('Copy')}">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                </Button>
                            </Grid>
                            <NumberBox x:Name="PortBox" Header="{x:Bind services:Loc.S('ApiPort')}" Minimum="1024" Maximum="65535" SpinButtonPlacementMode="Compact"
                                       ValueChanged="OnPortChanged" HorizontalAlignment="Left" MinWidth="160" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind services:Loc.S('ApiAccess')}" Style="{StaticResource SectionLabelStyle}" />
                            <ToggleSwitch x:Name="LanToggle" Header="{x:Bind services:Loc.S('ApiAllowLan')}" Toggled="OnAccessChanged" />
                            <TextBlock Text="{x:Bind services:Loc.S('ApiAllowLanHelp')}" Style="{StaticResource MutedTextStyle}" />
                            <ToggleSwitch x:Name="KeyToggle" Header="{x:Bind services:Loc.S('ApiRequireKey')}" Toggled="OnAccessChanged" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind services:Loc.S('ApiKey')}" Style="{StaticResource SectionLabelStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="KeyBox" IsEnabled="False" />
                            <Button Grid.Column="1" Click="OnCopyKey" AutomationProperties.Name="{x:Bind services:Loc.S('Copy')}">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            </Button>
                            <Button Grid.Column="2" Content="{x:Bind services:Loc.S('ApiNewKey')}" Click="OnNewKey" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind services:Loc.S('ApiEndpoints')}" Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="13" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                   Text="POST /v1/chat/completions   (OpenAI)&#x0a;POST /v1/messages           (Anthropic)&#x0a;POST /v1/messages/count_tokens&#x0a;GET  /v1/models" />
                        <TextBlock Text="{x:Bind services:Loc.S('ApiClaudeCode')}" Style="{StaticResource SectionLabelStyle}" Margin="0,8,0,0" />
                        <TextBox x:Name="ClaudeSnippet" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind services:Loc.S('ApiRecent')}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind services:Loc.S('ApiNoRequests')}" Style="{StaticResource MutedTextStyle}"
                               Visibility="{x:Bind local:Ui.Hide(HasApiRequests), Mode=OneWay}" />
                    <ItemsRepeater ItemsSource="{x:Bind Api.Requests}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="services:ApiRequestLog">
                                <Grid ColumnSpacing="12" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Time}" Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Client}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Path}" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Model}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Status}" AutomationProperties.AutomationId="ApiRequestStatus" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
