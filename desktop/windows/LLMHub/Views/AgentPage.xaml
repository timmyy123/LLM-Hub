<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LLMHub.Views.AgentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LLMHub"
    xmlns:views="using:LLMHub.Views"
    xmlns:services="using:LLMHub.Services"
    xmlns:agent="using:LLMHub.Services.Agent"
    xmlns:vm="using:LLMHub.ViewModels"
    Background="{ThemeResource AppBackgroundBrush}">

    <Page.Resources>
        <!-- Diff lines: green for added, red for removed, plain context (from the design's dark diff block). -->
        <DataTemplate x:Key="DiffLineTemplate" x:DataType="agent:DiffLine">
            <Border Background="{x:Bind local:Ui.DiffBackground(Kind)}" Padding="10,1">
                <TextBlock Text="{x:Bind local:Ui.DiffText(Kind, Text)}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                           Foreground="{x:Bind local:Ui.DiffForeground(Kind)}" TextWrapping="NoWrap" IsTextSelectionEnabled="True" />
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- Empty state: pick a folder (and install the engine if needed) -->
        <StackPanel x:Name="EmptyState" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" MaxWidth="560"
                    Visibility="{x:Bind local:Ui.Hide(ViewModel.HasSession), Mode=OneWay}">
            <TextBlock Text="{x:Bind services:Loc.S('AgentEmptyTitle')}" FontSize="26" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="AgentEmptyTitle" />
            <TextBlock Text="{x:Bind services:Loc.S('AgentEmptyBody')}" Foreground="{ThemeResource TextMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
            <Button x:Name="PickFolderButton" HorizontalAlignment="Center" Style="{StaticResource PrimaryPillButtonStyle}" Click="OnPickFolder"
                    Content="{x:Bind services:Loc.S('AgentPickFolder')}" />
            <!-- Engine for new sessions: Claude Code, or OpenClaw installed by the app. -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind services:Loc.S('AgentEngineTitle')}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox x:Name="AgentEnginePicker" Grid.Column="1" MinWidth="160" ItemsSource="{x:Bind ViewModel.Engines}" SelectedItem="{x:Bind ViewModel.EngineChoice, Mode=TwoWay}" />
                    </Grid>
                    <StackPanel Spacing="10" Visibility="{x:Bind local:Ui.Hide(ViewModel.IsEngineInstalled), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.InstallHelp, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="InstallClaudeButton" Content="{x:Bind ViewModel.InstallLabel, Mode=OneWay}" Command="{x:Bind ViewModel.InstallEngineCommand}"
                                    IsEnabled="{x:Bind local:Ui.Not(ViewModel.IsEngineInstalling), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.InstallStatus, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="AgentInstallStatus" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Session -->
        <Grid x:Name="SessionView" Visibility="{x:Bind local:Ui.Show(ViewModel.HasSession), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: title, folder, branch -->
            <StackPanel Orientation="Horizontal" Spacing="10" Padding="24,0" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
                <TextBlock x:Name="SessionTitle" Text="{x:Bind ViewModel.Selected.Title, Mode=OneWay, FallbackValue=''}" FontSize="15" FontWeight="Medium"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                <Border Height="26" Padding="10,0" CornerRadius="8" Background="{ThemeResource SurfaceAltBrush}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.Selected.Folder, Mode=OneWay, FallbackValue=''}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                   Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                    </StackPanel>
                </Border>
                <Border Height="26" Padding="10,0" CornerRadius="8" Background="{ThemeResource SurfaceAltBrush}" VerticalAlignment="Center"
                        Visibility="{x:Bind local:Ui.ShowText(ViewModel.Selected.Branch), Mode=OneWay, FallbackValue=Collapsed}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8AB;" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.Selected.Branch, Mode=OneWay, FallbackValue=''}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <ScrollViewer x:Name="Transcript" Grid.Row="1" Padding="24,24,24,12" HorizontalScrollMode="Disabled">
                <StackPanel MaxWidth="760" Spacing="16">
                    <!-- Tasks (the agent's TodoWrite list) -->
                    <Border CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource ChipBorderBrush}" Background="{ThemeResource SurfaceAltBrush}" Padding="14,12"
                            Visibility="{x:Bind local:Ui.ShowCount(ViewModel.Selected.Tasks.Count), Mode=OneWay, FallbackValue=Collapsed}" AutomationProperties.AutomationId="AgentTasks">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind services:Loc.S('AgentTasks')}" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource TextFaintBrush}" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Selected.Tasks, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="6" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="agent:AgentTask">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="{x:Bind local:Ui.TaskGlyph(Status), Mode=OneWay}" FontSize="13" Foreground="{x:Bind local:Ui.TaskBrush(Status), Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind Text, Mode=OneWay}" FontSize="13" TextWrapping="Wrap"
                                                       TextDecorations="{x:Bind local:Ui.TaskDecoration(Status), Mode=OneWay}"
                                                       Foreground="{x:Bind local:Ui.TaskTextBrush(Status), Mode=OneWay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <ItemsRepeater x:Name="AgentItems" ItemsSource="{x:Bind ViewModel.Selected.Items, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="14" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="agent:AgentItem">
                                <Grid>
                                    <!-- User -->
                                    <Border Visibility="{x:Bind local:Ui.Show(IsUser)}" HorizontalAlignment="Right" MaxWidth="600" Background="{ThemeResource UserBubbleBrush}"
                                            CornerRadius="16" Padding="16,12">
                                        <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="15" LineHeight="24" AutomationProperties.AutomationId="AgentUserMessage" />
                                    </Border>
                                    <!-- Assistant -->
                                    <views:MarkdownView Visibility="{x:Bind local:Ui.Show(IsAssistant)}" Text="{x:Bind Title}"
                                                        AutomationProperties.AutomationId="AgentMessage" AutomationProperties.Name="{x:Bind Title}" />
                                    <!-- Error -->
                                    <TextBlock Visibility="{x:Bind local:Ui.Show(IsError)}" Text="{x:Bind Title}" Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap" />
                                    <!-- Tool step: label, target, meta; diff or command output below -->
                                    <Border Visibility="{x:Bind local:Ui.Show(IsStep)}" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ChipBorderBrush}"
                                            Background="{ThemeResource SurfaceAltBrush}" AutomationProperties.AutomationId="AgentStep" AutomationProperties.Name="{x:Bind Title}">
                                        <StackPanel>
                                            <Grid Padding="12,9" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Detail}" FontSize="13" Foreground="{ThemeResource TextMutedBrush}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontFamily="Cascadia Mono, Consolas" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Meta, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFaintBrush}" />
                                            </Grid>
                                            <ItemsRepeater ItemsSource="{x:Bind Diff}" ItemTemplate="{StaticResource DiffLineTemplate}" Visibility="{x:Bind local:Ui.Show(HasDiff)}" Margin="0,0,0,8" />
                                            <TextBlock Text="{x:Bind Output, Mode=OneWay}" Visibility="{x:Bind local:Ui.Show(HasOutput), Mode=OneWay}" FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="12" Foreground="{ThemeResource TextMutedBrush}" Margin="12,0,12,10" TextWrapping="Wrap" MaxLines="12" IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Permission request -->
                    <Border x:Name="PermissionCard" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource WarningBrush}" Background="{ThemeResource SurfaceAltBrush}"
                            Padding="14" Visibility="{x:Bind local:Ui.ShowObject(ViewModel.Selected.Pending), Mode=OneWay, FallbackValue=Collapsed}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{x:Bind ViewModel.Selected.Pending.Question, Mode=OneWay, FallbackValue=''}" FontWeight="SemiBold" AutomationProperties.AutomationId="PermissionQuestion" />
                            <Border CornerRadius="8" Background="{ThemeResource AppBackgroundBrush}" Padding="10,8">
                                <TextBlock Text="{x:Bind ViewModel.Selected.Pending.Summary, Mode=OneWay, FallbackValue=''}" FontFamily="Cascadia Mono, Consolas" FontSize="13" TextWrapping="Wrap" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="AllowButton" Content="{x:Bind services:Loc.S('AgentAllow')}" Command="{x:Bind ViewModel.AllowCommand}"
                                        Background="{ThemeResource AccentFillBrush}" Foreground="{ThemeResource OnAccentBrush}" CornerRadius="8" />
                                <Button x:Name="AllowSessionButton" Content="{x:Bind services:Loc.S('AgentAllowSession')}" Command="{x:Bind ViewModel.AllowForSessionCommand}" CornerRadius="8" />
                                <Button x:Name="DenyButton" Content="{x:Bind services:Loc.S('AgentDeny')}" Command="{x:Bind ViewModel.DenyCommand}" CornerRadius="8" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Composer -->
            <StackPanel Grid.Row="2" Padding="24,8,24,16" Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.Notice, Mode=OneWay}" Foreground="{ThemeResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="760"
                           Visibility="{x:Bind local:Ui.ShowText(ViewModel.Notice), Mode=OneWay}" AutomationProperties.AutomationId="AgentNotice" />
                <Border MaxWidth="760" CornerRadius="18" BorderThickness="1" BorderBrush="{ThemeResource ControlBorderBrush}" Background="{ThemeResource SurfaceBrush}" Padding="14,12,14,10">
                    <StackPanel Spacing="10">
                        <TextBox x:Name="AgentComposer" Text="{x:Bind ViewModel.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 PlaceholderText="{x:Bind services:Loc.S('AgentPlaceholder')}" MaxHeight="200" FontSize="15" BorderThickness="0" Background="Transparent" Padding="4,2"
                                 PreviewKeyDown="OnComposerKeyDown">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            </TextBox.Resources>
                        </TextBox>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="AgentMode" ItemsSource="{x:Bind ViewModel.Modes}" SelectedItem="{x:Bind ViewModel.Mode, Mode=TwoWay}" FontSize="13" MinWidth="150" />
                            <ComboBox x:Name="AgentModelPicker" Grid.Column="2" ItemsSource="{x:Bind ViewModel.Models}" SelectedItem="{x:Bind ViewModel.SelectedModel, Mode=TwoWay}"
                                      FontSize="13" MinWidth="140" MaxWidth="240" BorderThickness="0" Background="Transparent" PlaceholderText="{x:Bind services:Loc.S('AgentModel')}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="services:InstalledModel">
                                        <TextBlock Text="{x:Bind DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button x:Name="AgentSend" Grid.Column="3" Width="36" Height="36" Padding="0" CornerRadius="10" Background="{ThemeResource AccentFillBrush}"
                                    Foreground="{ThemeResource OnAccentBrush}" BorderThickness="0" Command="{x:Bind ViewModel.SendCommand}"
                                    AutomationProperties.Name="{x:Bind services:Loc.S('Send')}"
                                    Visibility="{x:Bind local:Ui.Hide(ViewModel.Selected.IsWorking), Mode=OneWay, FallbackValue=Visible}">
                                <FontIcon Glyph="&#xE74A;" FontSize="14" />
                            </Button>
                            <Button x:Name="AgentStop" Grid.Column="3" Width="36" Height="36" Padding="0" CornerRadius="10" Command="{x:Bind ViewModel.StopCommand}"
                                    AutomationProperties.Name="{x:Bind services:Loc.S('Stop')}"
                                    Visibility="{x:Bind local:Ui.Show(ViewModel.Selected.IsWorking), Mode=OneWay, FallbackValue=Collapsed}">
                                <FontIcon Glyph="&#xE71A;" FontSize="12" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock Text="{x:Bind ViewModel.Footer, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFaintBrush}" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="760" />
            </StackPanel>
        </Grid>

        <!-- Side panel -->
        <Grid x:Name="SidePanel" Grid.Column="1" Background="{ThemeResource SidebarBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1,0,0,0"
              Visibility="{x:Bind local:Ui.Show(ViewModel.HasSession), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <SelectorBar x:Name="SideTabs" VerticalAlignment="Center" Margin="8,0" SelectionChanged="OnSideTabChanged">
                <SelectorBarItem Tag="diff" Text="{x:Bind services:Loc.S('AgentDiff')}" IsSelected="True" AutomationProperties.AutomationId="AgentTabDiff" />
                <SelectorBarItem Tag="terminal" Text="{x:Bind services:Loc.S('AgentTerminal')}" AutomationProperties.AutomationId="AgentTabTerminal" />
                <SelectorBarItem Tag="files" Text="{x:Bind services:Loc.S('AgentFiles')}" AutomationProperties.AutomationId="AgentTabFiles" />
                <SelectorBarItem Tag="preview" Text="{x:Bind services:Loc.S('AgentPreview')}" AutomationProperties.AutomationId="AgentTabPreview" />
            </SelectorBar>

            <!-- Diff -->
            <Grid x:Name="DiffPanel" Grid.Row="1" RowSpacing="8" Padding="12,4,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Bind services:Loc.S('AgentNoChanges')}" Style="{StaticResource MutedTextStyle}" Margin="4,8"
                           Visibility="{x:Bind local:Ui.HideCount(ViewModel.Selected.Changes.Count), Mode=OneWay, FallbackValue=Visible}" />
                <ListView x:Name="ChangeList" ItemsSource="{x:Bind ViewModel.Selected.Changes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedChange, Mode=TwoWay}"
                          ItemContainerStyle="{StaticResource ChatItemStyle}" MaxHeight="200">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="agent:FileChange">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind local:Ui.ChangeBadge(Kind)}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{x:Bind local:Ui.ChangeBrush(Kind)}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Path}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="ChangedFile" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Stats}" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" Margin="0,4,0,8">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedChange.Diff, Mode=OneWay}" ItemTemplate="{StaticResource DiffLineTemplate}" />
                </ScrollViewer>
            </Grid>

            <!-- Terminal -->
            <ScrollViewer x:Name="TerminalPanel" Grid.Row="1" Padding="14,8" Visibility="Collapsed">
                <TextBlock Text="{x:Bind ViewModel.Selected.Terminal, Mode=OneWay, FallbackValue=''}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                           Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="AgentTerminalText" />
            </ScrollViewer>

            <!-- Files -->
            <ListView x:Name="FilesPanel" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Files}" SelectionMode="None" Visibility="Collapsed" Padding="8,0"
                      IsItemClickEnabled="True" ItemClick="OnFileClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Preview -->
            <StackPanel x:Name="PreviewPanel" Grid.Row="1" Spacing="12" Padding="16" Visibility="Collapsed">
                <TextBlock x:Name="PreviewText" Style="{StaticResource MutedTextStyle}" />
                <Button x:Name="OpenPreviewButton" Content="{x:Bind services:Loc.S('AgentPreview')}" Click="OnOpenPreview" />
            </StackPanel>

            <!-- Revert / Commit -->
            <StackPanel Grid.Row="2" Padding="12" Spacing="8" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0">
                <TextBox x:Name="CommitMessageBox" Text="{x:Bind ViewModel.CommitMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="{x:Bind services:Loc.S('AgentCommitMessage')}" FontSize="13" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RevertButton" HorizontalAlignment="Stretch" Content="{x:Bind services:Loc.S('AgentRevert')}" Command="{x:Bind ViewModel.RevertCommand}" CornerRadius="8" />
                    <Button x:Name="CommitButton" Grid.Column="1" HorizontalAlignment="Stretch" Content="{x:Bind services:Loc.S('AgentCommit')}" Command="{x:Bind ViewModel.CommitCommand}"
                            CornerRadius="8" Background="{ThemeResource TextPrimaryBrush}" Foreground="{ThemeResource AppBackgroundBrush}" />
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
