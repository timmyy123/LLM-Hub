<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>LLMHub</RootNamespace>
    <AssemblyName>LLMHub</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefaultLanguage>en-US</DefaultLanguage>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.1.0</Version>
    <!-- Same logo as the iOS and Android apps. -->
    <ApplicationIcon>..\..\shared\icons\llmhub.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
      <Content Include="..\..\shared\licenses\*" Link="Licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Engines, downloads, chat, Local API and view models, shared with the Linux app. -->
    <ProjectReference Include="..\..\core\LLMHub.Core\LLMHub.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\shared\icons\llmhub.ico" Link="Assets\llmhub.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\shared\icons\llmhub.png" Link="Assets\llmhub.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
