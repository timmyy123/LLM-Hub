<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LLMHub.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LLMHub"
    xmlns:services="using:LLMHub.Services"
    xmlns:vm="using:LLMHub.ViewModels"
    Title="LLM Hub">

    <Grid x:Name="Root" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Background="{ThemeResource TitleBarBrush}">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="LLM Hub" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock x:Name="SectionTitle" FontSize="13" Foreground="{ThemeResource TextMutedBrush}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Background="{ThemeResource SidebarBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,1,0" Padding="10,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button x:Name="NewChatButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="40" CornerRadius="10"
                        Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource ControlBorderBrush}" Click="OnNewChat">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="{x:Bind services:Loc.S('NewChat')}" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <ListView x:Name="NavList" Grid.Row="1" Margin="-4,10,-4,0" SelectionMode="Single" SelectionChanged="OnNavChanged">
                    <ListViewItem Tag="chat" AutomationProperties.AutomationId="NavChat">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8BD;" FontSize="16" />
                            <TextBlock Text="{x:Bind services:Loc.S('NavChat')}" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="agent" AutomationProperties.AutomationId="NavAgent">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE756;" FontSize="16" />
                            <TextBlock Text="{x:Bind services:Loc.S('NavAgent')}" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="design" AutomationProperties.AutomationId="NavDesign">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE790;" FontSize="16" />
                            <TextBlock Text="{x:Bind services:Loc.S('NavDesign')}" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="studio" AutomationProperties.AutomationId="NavStudio">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE91B;" FontSize="16" />
                            <TextBlock Text="{x:Bind services:Loc.S('NavStudio')}" />
                        </StackPanel>
                    </ListViewItem>
                </ListView>

                <TextBox x:Name="ChatSearch" Grid.Row="2" Margin="0,12,0,4" PlaceholderText="{x:Bind services:Loc.S('SearchChats')}"
                         Text="{x:Bind Chat.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <ListView x:Name="ChatList" Grid.Row="3" Margin="-4,4,-4,0" SelectionMode="Single" IsSynchronizedWithCurrentItem="False"
                          ItemsSource="{x:Bind ChatGroupsSource.View, Mode=OneWay}"
                          SelectedItem="{x:Bind Chat.SelectedChat, Mode=TwoWay}">
                    <ListView.GroupStyle>
                        <GroupStyle HidesIfEmpty="True">
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="vm:ChatGroup">
                                    <TextBlock Text="{x:Bind Key}" Style="{StaticResource SectionLabelStyle}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatSummary">
                            <Grid>
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="{x:Bind services:Loc.S('DeleteChat')}" Click="OnDeleteChat" Tag="{x:Bind}" AutomationProperties.AutomationId="DeleteChatMenuItem">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextSecondaryBrush}" AutomationProperties.AutomationId="ChatTitle" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Settings mode: the same sidebar shows a Back button and the settings sections. -->
                <StackPanel x:Name="SettingsNav" Grid.Row="0" Grid.RowSpan="4" Spacing="10" Visibility="Collapsed">
                    <Button x:Name="BackButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="40" CornerRadius="10"
                            Background="Transparent" BorderThickness="0" Click="OnBackFromSettings">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE72B;" FontSize="14" />
                            <TextBlock Text="{x:Bind services:Loc.S('Back')}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{x:Bind services:Loc.S('NavSettings')}" Style="{StaticResource SectionLabelStyle}" Margin="12,6,0,0" />
                    <ListView x:Name="SettingsSectionList" Margin="-4,0,-4,0" SelectionMode="Single" SelectionChanged="OnSettingsSectionChanged">
                        <ListViewItem Tag="general" AutomationProperties.AutomationId="SectionGeneral">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE713;" FontSize="16" />
                                <TextBlock Text="{x:Bind services:Loc.S('SettingsGeneral')}" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="models" AutomationProperties.AutomationId="SectionModels">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE950;" FontSize="16" />
                                <TextBlock Text="{x:Bind services:Loc.S('SettingsModels')}" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="api" AutomationProperties.AutomationId="SectionApi">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE968;" FontSize="16" />
                                <TextBlock Text="{x:Bind services:Loc.S('SettingsLocalApi')}" />
                            </StackPanel>
                        </ListViewItem>
                    </ListView>
                </StackPanel>

                <Button x:Name="SettingsButton" Grid.Row="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,10,0,0" Padding="12,10"
                        CornerRadius="10" Background="{ThemeResource SurfaceAltBrush}" BorderThickness="0" Click="OnOpenSettings">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="EngineDot" Width="8" Height="8" Fill="{ThemeResource TextFaintBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="EngineStatus" Text="{x:Bind Engine.StatusText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="HardwareLine" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource TextMutedBrush}" />
                    </Grid>
                </Button>
            </Grid>

            <Frame x:Name="ContentFrame" Grid.Column="1" />
        </Grid>
    </Grid>
</Window>
