"tos_last_updated" = "अंतिम अपडेट: 16 जुलाई, 2025";
"tos_welcome_text" = "LLM Hub में आपका स्वागत है। हमारे एप्लिकेशन का उपयोग करके, आप इन सेवा की शर्तों से बाध्य होने के लिए सहमत होते हैं। कृपया इन्हें ध्यान से पढ़ें।";
"tos_welcome" = "LLM Hub में आपका स्वागत है। हमारे एप्लिकेशन का उपयोग करके, आप इन सेवा की शर्तों से बाध्य होने के लिए सहमत होते हैं। कृपया इन्हें ध्यान से पढ़ें।";
"tos_acceptance_title" = "1. शर्तों की स्वीकृति";
"tos_acceptance_text" = "LLM Hub को डाउनलोड, इंस्टॉल या उपयोग करके, आप स्वीकार करते हैं कि आपने इन सेवा की शर्तों को पढ़ और समझ लिया है तथा इनसे बाध्य होने के लिए सहमत हैं। यदि आप इन शर्तों से सहमत नहीं हैं, तो कृपया एप्लिकेशन का उपयोग न करें।";
"tos_app_description_title" = "2. एप्लिकेशन विवरण";
"tos_app_description_text" = "LLM Hub एक ओपन-सोर्स एप्लिकेशन है जो ऑन-डिवाइस AI बातचीत के लिए बड़े भाषा मॉडल (LLMs) तक पहुंच प्रदान करता है। ऐप आपके डिवाइस पर स्थानीय रूप से सभी डेटा को प्रोसेस करता है और बाहरी सर्वरों पर व्यक्तिगत जानकारी प्रसारित नहीं करता है।";
"tos_user_responsibilities_title" = "3. उपयोगकर्ता की जिम्मेदारियां";
"tos_user_responsibilities_text" = "आप LLM Hub का उपयोग जिम्मेदारी से और लागू कानूनों के अनुसार करने के लिए सहमत हैं। आप इसके लिए जिम्मेदार हैं:\n\n• केवल वैध उद्देश्यों के लिए एप्लिकेशन का उपयोग करना\n• एप्लिकेशन को रिवर्स इंजीनियर या संशोधित करने का प्रयास न करना\n• हानिकारक, अवैध या आपत्तिजनक सामग्री उत्पन्न करने के लिए एप्लिकेशन का उपयोग न करना\n• तीसरे पक्षों के बौद्धिक संपदा अधिकारों का सम्मान करना\n• यह सुनिश्चित करना कि आपका डिवाइस उचित संचालन के लिए न्यूनतम आवश्यकताओं को पूरा करता है";
"tos_privacy_data_title" = "4. गोपनीयता और डेटा";
"tos_privacy_data_text" = "LLM Hub को गोपनीयता को ध्यान में रखकर डिज़ाइन किया गया है:\n\n• सभी बातचीत और डेटा प्रोसेसिंग आपके डिवाइस पर स्थानीय रूप से होती है\n• कोई भी व्यक्तिगत डेटा बाहरी सर्वरों पर नहीं भेजा जाता है\n• चैट इतिहास स्थानीय रूप से संग्रहीत होता है और इसे किसी भी समय हटाया जा सकता है\n• मॉडल डाउनलोड सीधे आधिकारिक रिपॉजिटरी (HuggingFace, Google) से किए जाते हैं\n• एप्लिकेशन एनालिटिक्स या उपयोग डेटा एकत्र नहीं करता है";
"tos_disclaimer_title" = "5. वारंटियों का अस्वीकरण";
"tos_disclaimer_text" = "LLM Hub बिना किसी भी प्रकार की वारंटी के \"जैसा है\" प्रदान किया जाता है। हम एप्लिकेशन या इसकी उत्पन्न सामग्री की सटीकता, विश्वसनीयता या उपलब्धता की गारंटी नहीं देते हैं। AI मॉडल के उपयोग से अप्रत्याशित परिणाम उत्पन्न हो सकते हैं।";
"tos_limitation_liability_title" = "6. दायित्व की सीमा";
"tos_limitation_liability_text" = "किसी भी स्थिति में डेवलपर्स LLM Hub के उपयोग से उत्पन्न होने वाले किसी भी अप्रत्यक्ष, आकस्मिक या परिणामी नुकसान के लिए उत्तरदायी नहीं होंगे। एप्लिकेशन का उपयोग आपके अपने जोखिम पर है।";
"tos_model_usage_title" = "7. मॉडल उपयोग और लाइसेंसिंग";
"tos_model_usage_text" = "LLM Hub के माध्यम से उपलब्ध AI मॉडल उनके संबंधित लाइसेंस और उपयोग की शर्तों के अधीन हैं। डाउनलोड किए गए मॉडल का उपयोग करते समय उपयोगकर्ता मॉडल-विशिष्ट लाइसेंसिंग आवश्यकताओं का पालन करने के लिए जिम्मेदार हैं।";
"tos_open_source_title" = "8. ओपन सोर्स लाइसेंस";
"tos_open_source_text" = "LLM Hub ओपन-सोर्स सॉफ्टवेयर है। स्रोत कोड गैर-व्यावसायिक लाइसेंस के तहत उपलब्ध है, जो लाइसेंस की शर्तों के अधीन उपयोग, संशोधन और वितरण की अनुमति देता है।";
"tos_changes_title" = "9. शर्तों में बदलाव";
"tos_changes_text" = "हम समय-समय पर इन सेवा की शर्तों को अपडेट कर सकते हैं। ऐप अपडेट के माध्यम से उपयोगकर्ताओं को महत्वपूर्ण परिवर्तनों की सूचना दी जाएगी। परिवर्तनों के बाद एप्लिकेशन का निरंतर उपयोग नई शर्तों की स्वीकृति माना जाएगा।";
"tos_contact_title" = "10. संपर्क जानकारी";
"tos_contact_text" = "इन सेवा की शर्तों के बारे में प्रश्नों के लिए, कृपया timmy@llm-hub.app पर हमसे संपर्क करें।";
