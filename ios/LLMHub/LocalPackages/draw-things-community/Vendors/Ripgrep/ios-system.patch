+        Ok(code) => code,
+        Err(_) => {
+            system_io::write_error(format_args!("internal panic"));
+            return 2;
+        }
+    };
+    if code == ExitCode::SUCCESS {
+        0
+    } else if code == ExitCode::from(1) {
+        1
+    } else {
+        2
+    }
+}
