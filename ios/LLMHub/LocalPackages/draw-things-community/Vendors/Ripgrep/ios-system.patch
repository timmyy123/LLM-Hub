+/// Embedded entry point shared by Local Code and ios_system. Each invocation
+/// is serialized because ripgrep has process-global logger and message state.
+/// Search workers remain parallel.
+#[no_mangle]
+pub unsafe extern "C" fn rg_main(
+    argc: c_int,
+    argv: *mut *mut c_char,
+) -> c_int {
+    let _invocation = system_io::Invocation::begin();
+    if argc < 1 || argv.is_null() {
+        system_io::write_error(format_args!("invalid argument vector"));
+        return 2;
+    }
+    let mut rawargs = Vec::with_capacity((argc - 1) as usize);
+    for index in 1..argc {
+        let argument = *argv.add(index as usize);
+        if argument.is_null() {
+            system_io::write_error(format_args!("invalid null argument"));
+            return 2;
+        }
+        let bytes = CStr::from_ptr(argument).to_bytes();
+        rawargs.push(OsString::from_vec(bytes.to_vec()));
