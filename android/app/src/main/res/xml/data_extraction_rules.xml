<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12 and higher.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   Encrypted preferences are excluded: their key lives in the Android Keystore, which is never backed up or
   transferred, so a restored copy can't be decrypted on the new device (javax.crypto.AEADBadTagException).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="agent_mcp_secure.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="agent_mcp_secure.xml"/>
    </device-transfer>
</data-extraction-rules>
