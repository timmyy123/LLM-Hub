<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- VitalsFixes3DeviceTest: a content provider that answers slowly, in the test package's process. -->
        <provider
            android:name="com.llmhub.llmhub.SlowVideoProvider"
            android:authorities="com.llmhub.llmhub.test.slowvideo"
            android:exported="true" />
        <!-- Keeps the screen on during device tests where adb power commands cannot be used (see the class). -->
        <activity
            android:name="com.llmhub.llmhub.KeepAwakeActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
    </application>
</manifest>
